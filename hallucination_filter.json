{
  "description": "Whisper幻觉过滤配置 - 可自定义规则，无需重新编译",

  "whisper_features": {
    "no_speech_prob_threshold": 0.8,
    "avg_logprob_threshold": -1.2,
    "compression_ratio_threshold": 2.4,
    "compression_ratio_threshold_zh": 4.5,
    "compression_ratio_threshold_ja": 4.0,
    "compression_ratio_threshold_ko": 4.0
  },

  "text_filters": {
    "min_length": 2,
    "max_length": 200,

    "exact_matches": [
