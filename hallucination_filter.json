      "仅供",
      "版权所有",
      "Copyright",
      "youtube.com",
      "bilibili.com",
      "订阅",
      "Subscribe",
      "作曲",
      "作词",
      "编曲",
      "制作人",
      "混音",
      "母带",
      "出品",
      "发行",
      "制作公司",
      "录音",
      "音乐公司",
      "QQ音乐",
      "网易云音乐",
      "网易音乐",
      "酷狗音乐",
      "酷我音乐",
      "Apple Music",
      "Spotify",
