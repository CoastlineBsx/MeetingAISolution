{
  "version": "2.0.0",
  "options": {
    "env": {
      "MSBUILD": "C:\\Program Files\\Microsoft Visual Studio\\2022\\Community\\MSBuild\\Current\\Bin\\amd64\\MSBuild.exe"
    }
  },
  "tasks": [
    {
      "label": "build all (x64 Debug)",
      "type": "shell",
      "command": "& \"${env:MSBUILD}\" MeetingAISolution.sln -restore -p:Configuration=Debug -p:Platform=x64 -m -v:minimal",
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build worker",
      "type": "shell",
      "command": "& \"${env:MSBUILD}\" MeetingAI.Worker\\MeetingAI.Worker.vcxproj -p:SolutionDir=${workspaceFolder}\\ -p:Configuration=Debug -p:Platform=x64 -m -v:minimal",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build host",
      "type": "shell",
      "command": "& \"${env:MSBUILD}\" MeetingAI.Host\\MeetingAI.Host.csproj -restore -p:Configuration=Debug -p:Platform=x64 -m -v:minimal",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run host",
      "type": "shell",
      "command": "& \".\\artifacts\\bin\\Debug\\x64\\x64\\Debug\\net8.0-windows10.0.19041.0\\MeetingAI.Host.exe\"",
      "options": { "cwd": "${workspaceFolder}" },
      "dependsOn": "build all (x64 Debug)",
      "problemMatcher": []
    }
  ]
}
