<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>MeetingAI.Host</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>false</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <!-- 保持默认：自动包含 App.xaml / *.xaml，避免重复 -->
    <!-- 不要设置 EnableDefaultPageItems=false -->
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!-- WinUI / Windows App SDK 依赖 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="NAudio" />
    <PackageReference Include="FFMpegCore" />
  </ItemGroup>

  <!-- 让“打包和发布”菜单可用（保持原样） -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Configuration\" />
    <Folder Include="Presentation\" />
    <Folder Include="Services\" />
  </ItemGroup>

  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- 发布设置：Host层因有UI/音频/COM依赖，禁用裁剪 -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!-- Host层禁用Trim：保留完整COM/WinRT/NAudio支持 -->
    <PublishTrimmed>False</PublishTrimmed>
    <EnableComHosting>true</EnableComHosting>
    <EnableGeneratedComInterfaceComImportInterop>true</EnableGeneratedComInterfaceComImportInterop>
  <OutputPath>$(SolutionDir)artifacts\bin\$(MSBuildProjectName)\$(Platform)\$(Configuration)\</OutputPath>
  <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="C:\Users\Shaoxiong Bai\.nuget\packages\microsoft.windowsappsdk\1.7.250606001\buildTransitive\..\include\WindowsAppSDK-VersionInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="C:\Users\Shaoxiong Bai\.nuget\packages\microsoft.windowsappsdk\1.7.250606001\include\WindowsAppSDK-VersionInfo.cs" Link="WindowsAppSDK-VersionInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="C:\Users\Shaoxiong Bai\.nuget\packages\microsoft.windowsappsdk\1.7.250606001\include\MddBootstrapAutoInitializer.cs" Link="MddBootstrapAutoInitializer.cs" />
  </ItemGroup>


</Project>
