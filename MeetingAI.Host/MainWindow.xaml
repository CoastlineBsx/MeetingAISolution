<Window
    x:Class="MeetingAI.Host.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Meeting AI (Local)">
    <Grid Padding="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 顶部按钮区 - 3行布局 -->
        <StackPanel Grid.ColumnSpan="2" Spacing="8">
            <!-- 第一行：基础控制 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnStart" Content="启动 Worker" Click="BtnStart_Click"/>
                <ComboBox x:Name="CmbGraniteDevice" SelectedIndex="1" MinWidth="110" VerticalAlignment="Center">
                    <ComboBoxItem Content="🧠 Granite-CPU"/>
                    <ComboBoxItem Content="🧠 Granite-GPU"/>
                    <ComboBoxItem Content="🧠 Granite-NPU"/>
                </ComboBox>
                <ComboBox x:Name="CmbEmbeddingDevice" SelectedIndex="1" MinWidth="130" VerticalAlignment="Center">
                    <ComboBoxItem Content="📊 Embedding-CPU"/>
                    <ComboBoxItem Content="📊 Embedding-GPU"/>
                    <ComboBoxItem Content="📊 Embedding-NPU"/>
                </ComboBox>
                <Button x:Name="BtnPreloadModels" Content="🚀 开始加载模型" Click="BtnPreloadModels_Click" IsEnabled="False"/>
                <Button x:Name="BtnPing"  Content="发送测试消息" Click="BtnPing_Click" IsEnabled="False"/>

                <!-- 测试转录组 -->
                <Button x:Name="BtnTranscribe" Content="测试转录" Click="BtnTranscribe_Click" IsEnabled="False"/>
                <ComboBox x:Name="CmbTranscribeMode" SelectedIndex="0" MinWidth="120" VerticalAlignment="Center">
                    <ComboBoxItem Content="🎤 对话/会议"/>
                    <ComboBoxItem Content="🎵 音乐/歌曲"/>
                    <ComboBoxItem Content="🎭 混合模式"/>
                </ComboBox>
                <ComboBox x:Name="CmbTranscribeLanguage" SelectedIndex="0" MinWidth="100" VerticalAlignment="Center">
                    <ComboBoxItem Content="🌐 自动"/>
                    <ComboBoxItem Content="🇨🇳 中文"/>
                    <ComboBoxItem Content="🇺🇸 英语"/>
                    <ComboBoxItem Content="🇯🇵 日语"/>
                    <ComboBoxItem Content="🇰🇷 韩语"/>
                    <ComboBoxItem Content="🇪🇸 西班牙语"/>
                    <ComboBoxItem Content="🇫🇷 法语"/>
                    <ComboBoxItem Content="🇩🇪 德语"/>
                </ComboBox>

                <Button x:Name="BtnStop"  Content="停止 Worker" Click="BtnStop_Click" IsEnabled="False"/>
                <Button x:Name="BtnTestEmbedding" Content="🧪 测试Embedding" Click="BtnTestEmbedding_Click" IsEnabled="False"/>
                <Button x:Name="BtnTestSimilarity" Content="🔍 诊断相似度" Click="BtnTestSimilarity_Click" IsEnabled="False"/>
                <TextBlock x:Name="LblStatus" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 第二行：音频捕获功能 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- 扬声器转录组 -->
                <Button x:Name="BtnLoopback" Content="🔊 扬声器转录" Click="BtnLoopback_Click" IsEnabled="False"/>
                <ComboBox x:Name="CmbLoopbackDevice" SelectedIndex="0" MinWidth="180" VerticalAlignment="Center" SelectionChanged="CmbLoopbackDevice_SelectionChanged">
                    <ComboBoxItem Content="[默认扬声器]" Tag="default"/>
                </ComboBox>
                <ComboBox x:Name="CmbLoopbackMode" SelectedIndex="0" MinWidth="120" VerticalAlignment="Center">
                    <ComboBoxItem Content="🎤 对话/会议"/>
                    <ComboBoxItem Content="🎵 音乐/歌曲"/>
                    <ComboBoxItem Content="🎭 混合模式"/>
                </ComboBox>
                <ComboBox x:Name="CmbLoopbackLanguage" SelectedIndex="0" MinWidth="100" VerticalAlignment="Center">
                    <ComboBoxItem Content="🌐 自动"/>
                    <ComboBoxItem Content="🇨🇳 中文"/>
                    <ComboBoxItem Content="🇺🇸 英语"/>
                    <ComboBoxItem Content="🇯🇵 日语"/>
                    <ComboBoxItem Content="🇰🇷 韩语"/>
                    <ComboBoxItem Content="🇪🇸 西班牙语"/>
                    <ComboBoxItem Content="🇫🇷 法语"/>
                    <ComboBoxItem Content="🇩🇪 德语"/>
                </ComboBox>

                <!-- 麦克风转录组 -->
                <Button x:Name="BtnMicrophone" Content="🎤 麦克风转录" Click="BtnMicrophone_Click" IsEnabled="False"/>
                <ComboBox x:Name="CmbMicrophoneDevice" SelectedIndex="0" MinWidth="150" VerticalAlignment="Center" SelectionChanged="CmbMicrophoneDevice_SelectionChanged">
                    <ComboBoxItem Content="[默认麦克风]" Tag="default"/>
                </ComboBox>
                <ComboBox x:Name="CmbMicrophoneMode" SelectedIndex="0" MinWidth="120" VerticalAlignment="Center">
                    <ComboBoxItem Content="🎤 对话/会议"/>
                    <ComboBoxItem Content="🎵 音乐/歌曲"/>
                    <ComboBoxItem Content="🎭 混合模式"/>
                </ComboBox>
                <ComboBox x:Name="CmbMicrophoneLanguage" SelectedIndex="0" MinWidth="100" VerticalAlignment="Center">
                    <ComboBoxItem Content="🌐 自动"/>
                    <ComboBoxItem Content="🇨🇳 中文"/>
                    <ComboBoxItem Content="🇺🇸 英语"/>
                    <ComboBoxItem Content="🇯🇵 日语"/>
                    <ComboBoxItem Content="🇰🇷 韩语"/>
                    <ComboBoxItem Content="🇪🇸 西班牙语"/>
                    <ComboBoxItem Content="🇫🇷 法语"/>
                    <ComboBoxItem Content="🇩🇪 德语"/>
                </ComboBox>

            </StackPanel>

            <!-- 第三行：综合模式转录功能 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- 综合模式转录组（方案B：定时器同步）-->
                <Button x:Name="BtnMeeting" Content="📞 综合转录" Click="BtnMeeting_Click" IsEnabled="False"/>
                <ComboBox x:Name="CmbMeetingSpeakerDevice" SelectedIndex="0" MinWidth="180" VerticalAlignment="Center" SelectionChanged="CmbMeetingSpeakerDevice_SelectionChanged">
                    <ComboBoxItem Content="[默认扬声器]" Tag="default"/>
                </ComboBox>
                <ComboBox x:Name="CmbMeetingDevice" SelectedIndex="0" MinWidth="150" VerticalAlignment="Center" SelectionChanged="CmbMeetingDevice_SelectionChanged">
                    <ComboBoxItem Content="[默认麦克风]" Tag="default"/>
                </ComboBox>
                <ComboBox x:Name="CmbMeetingMode" SelectedIndex="0" MinWidth="120" VerticalAlignment="Center">
                    <ComboBoxItem Content="🎤 对话/会议"/>
                    <ComboBoxItem Content="🎵 音乐/歌曲"/>
                    <ComboBoxItem Content="🎭 混合模式"/>
                </ComboBox>
                <ComboBox x:Name="CmbMeetingLanguage" SelectedIndex="0" MinWidth="100" VerticalAlignment="Center">
                    <ComboBoxItem Content="🌐 自动"/>
                    <ComboBoxItem Content="🇨🇳 中文"/>
                    <ComboBoxItem Content="🇺🇸 英语"/>
                    <ComboBoxItem Content="🇯🇵 日语"/>
                    <ComboBoxItem Content="🇰🇷 韩语"/>
                    <ComboBoxItem Content="🇪🇸 西班牙语"/>
                    <ComboBoxItem Content="🇫🇷 法语"/>
                    <ComboBoxItem Content="🇩🇪 德语"/>
                </ComboBox>

                <!-- 综合模式（beta）转录组（方案A：事后对齐）-->
                <Button x:Name="BtnMeetingBeta" Content="📞 综合转录Beta" Click="BtnMeetingBeta_Click" IsEnabled="False"/>
                <ComboBox x:Name="CmbMeetingBetaSpeakerDevice" SelectedIndex="0" MinWidth="180" VerticalAlignment="Center" SelectionChanged="CmbMeetingBetaSpeakerDevice_SelectionChanged">
                    <ComboBoxItem Content="[默认扬声器]" Tag="default"/>
                </ComboBox>
                <ComboBox x:Name="CmbMeetingBetaDevice" SelectedIndex="0" MinWidth="150" VerticalAlignment="Center" SelectionChanged="CmbMeetingBetaDevice_SelectionChanged">
                    <ComboBoxItem Content="[默认麦克风]" Tag="default"/>
                </ComboBox>
                <ComboBox x:Name="CmbMeetingBetaMode" SelectedIndex="0" MinWidth="120" VerticalAlignment="Center">
                    <ComboBoxItem Content="🎤 对话/会议"/>
                    <ComboBoxItem Content="🎵 音乐/歌曲"/>
                    <ComboBoxItem Content="🎭 混合模式"/>
                </ComboBox>
                <ComboBox x:Name="CmbMeetingBetaLanguage" SelectedIndex="0" MinWidth="100" VerticalAlignment="Center">
                    <ComboBoxItem Content="🌐 自动"/>
                    <ComboBoxItem Content="🇨🇳 中文"/>
                    <ComboBoxItem Content="🇺🇸 英语"/>
                    <ComboBoxItem Content="🇯🇵 日语"/>
                    <ComboBoxItem Content="🇰🇷 韩语"/>
                    <ComboBoxItem Content="🇪🇸 西班牙语"/>
                    <ComboBoxItem Content="🇫🇷 法语"/>
                    <ComboBoxItem Content="🇩🇪 德语"/>
                </ComboBox>
            </StackPanel>

            <!-- 第四行：综合转录Beta2 + 流式转录 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- 综合模式（beta2）转录组 -->
                <Button x:Name="BtnMeetingBeta2" Content="📞 综合转录Beta2" Click="BtnMeetingBeta2_Click" IsEnabled="False"/>
                <ComboBox x:Name="CmbMeetingBeta2SpeakerDevice" SelectedIndex="0" MinWidth="180" VerticalAlignment="Center" SelectionChanged="CmbMeetingBeta2SpeakerDevice_SelectionChanged">
                    <ComboBoxItem Content="[默认扬声器]" Tag="default"/>
                </ComboBox>
                <ComboBox x:Name="CmbMeetingBeta2Device" SelectedIndex="0" MinWidth="150" VerticalAlignment="Center" SelectionChanged="CmbMeetingBeta2Device_SelectionChanged">
                    <ComboBoxItem Content="[默认麦克风]" Tag="default"/>
                </ComboBox>
                <ComboBox x:Name="CmbMeetingBeta2Mode" SelectedIndex="0" MinWidth="120" VerticalAlignment="Center">
                    <ComboBoxItem Content="🎤 对话/会议"/>
                    <ComboBoxItem Content="🎵 音乐/歌曲"/>
                    <ComboBoxItem Content="🎭 混合模式"/>
                </ComboBox>
                <ComboBox x:Name="CmbMeetingBeta2Language" SelectedIndex="0" MinWidth="100" VerticalAlignment="Center">
                    <ComboBoxItem Content="🌐 自动"/>
                    <ComboBoxItem Content="🇨🇳 中文"/>
                    <ComboBoxItem Content="🇺🇸 英语"/>
                    <ComboBoxItem Content="🇯🇵 日语"/>
                    <ComboBoxItem Content="🇰🇷 韩语"/>
                    <ComboBoxItem Content="🇪🇸 西班牙语"/>
                    <ComboBoxItem Content="🇫🇷 法语"/>
                    <ComboBoxItem Content="🇩🇪 德语"/>
                </ComboBox>
            </StackPanel>

            <!-- 第五行：Granite AI 对话控制 -->
            <!-- 第一行：全局控制（单轮/多轮/清空历史） -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="💬 AI 对话：" VerticalAlignment="Center" FontWeight="Bold"/>
                <Button x:Name="BtnGraniteSingle" Content="🔄 单轮模式"
                        Click="BtnGraniteSingle_Click" IsEnabled="False"/>
                <Button x:Name="BtnGraniteMulti" Content="💬 多轮模式"
                        Click="BtnGraniteMulti_Click" IsEnabled="False"/>
                <Button x:Name="BtnGraniteClear" Content="🗑️ 清空历史"
                        Click="BtnGraniteClear_Click" IsEnabled="False"/>
                <TextBlock x:Name="LblGraniteMode" Text="[单轮模式]"
                           VerticalAlignment="Center" Foreground="Gray"/>
            </StackPanel>

            <!-- 第二行：5个对话模式选择 -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="    " VerticalAlignment="Center"/>
                <Button x:Name="BtnNormalMode" Content="💬 普通对话"
                        Click="BtnNormalMode_Click" IsEnabled="False"
                        Padding="8,4"/>
                <Button x:Name="BtnQuickQA" Content="⚡ 快速问答"
                        Click="BtnQuickQA_Click" IsEnabled="False"
                        Padding="8,4"/>
                <Button x:Name="BtnIEMode" Content="🔍 IE模式"
                        Click="BtnIEMode_Click" IsEnabled="False"
                        Padding="8,4"/>
                <Button x:Name="BtnRAGMode" Content="📚 RAG模式"
                        Click="BtnRAGMode_Click" IsEnabled="False"
                        Padding="8,4"/>
                <Button x:Name="BtnLLaVAMode" Content="🖼️ 视觉问答"
                        Click="BtnLLaVAMode_Click" IsEnabled="False"
                        Padding="8,4"/>
            </StackPanel>

            <!-- 第三行：动态显示区域 -->
            <StackPanel x:Name="ModeContentArea" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="    " VerticalAlignment="Center"/>
                <!-- 状态文字在前 -->
                <TextBlock x:Name="LblModeStatus" Text=""
                           VerticalAlignment="Center" Foreground="Gray"/>

                <!-- QuickQA 模式专用控件（默认隐藏） -->
                <Button x:Name="BtnQuickQALoad" Content="📎 加载文件"
                        Click="BtnQuickQALoad_Click" IsEnabled="False"
                        Visibility="Collapsed"
                        Padding="6,4" FontSize="12"/>
                <TextBlock x:Name="LblQuickQADoc" Text="未加载文档"
                           VerticalAlignment="Center" Foreground="Gray" FontSize="12"
                           Visibility="Collapsed"/>
                <Button x:Name="BtnQuickQAClear" Content="❌ 清除文件"
                        Click="BtnQuickQAClear_Click" IsEnabled="False"
                        Visibility="Collapsed"
                        Padding="6,4" FontSize="12"/>

                <!-- RAG 模式专用按钮（默认隐藏） -->
                <Button x:Name="BtnRAGTest" Content="🧪 添加测试文档"
                        Click="BtnRAGTest_Click" IsEnabled="False"
                        Visibility="Collapsed"
                        Padding="6,4" FontSize="12"/>
                <Button x:Name="BtnDocumentManage" Content="📚 文档管理"
                        Click="BtnDocumentManage_Click" IsEnabled="False"
                        Visibility="Collapsed"
                        Padding="6,4" FontSize="12"/>

                <!-- IE 模式专用控件（默认隐藏） -->
                <Button x:Name="BtnIELoad" Content="📎 加载文件"
                        Click="BtnIELoad_Click" IsEnabled="False"
                        Visibility="Collapsed"
                        Padding="6,4" FontSize="12"/>
                <ComboBox x:Name="CmbIETemplate"
                          SelectionChanged="CmbIETemplate_SelectionChanged"
                          IsEnabled="False"
                          Visibility="Collapsed"
                          MinWidth="150" FontSize="12">
                    <!-- 模板选项会在代码中动态填充 -->
                </ComboBox>
                <TextBlock x:Name="LblIEDoc" Text="未加载文档"
                           VerticalAlignment="Center" Foreground="Gray" FontSize="12"
                           Visibility="Collapsed"/>
                <Button x:Name="BtnIEExtract" Content="▶️ 开始提取"
                        Click="BtnIEExtract_Click" IsEnabled="False"
                        Visibility="Collapsed"
                        Padding="6,4" FontSize="12"/>
                <TextBlock x:Name="LblIEStatus" Text=""
                           VerticalAlignment="Center" Foreground="Gray" FontSize="12"
                           Visibility="Collapsed"/>
                <Button x:Name="BtnIECopyJSON" Content="📋 复制JSON"
                        Click="BtnIECopyJSON_Click" IsEnabled="False"
                        Visibility="Collapsed"
                        Padding="6,4" FontSize="12"/>
                <Button x:Name="BtnIEExport" Content="💾 导出"
                        Click="BtnIEExport_Click" IsEnabled="False"
                        Visibility="Collapsed"
                        Padding="6,4" FontSize="12"/>
                <Button x:Name="BtnIEReExtract" Content="🔄 重新提取"
                        Click="BtnIEReExtract_Click" IsEnabled="False"
                        Visibility="Collapsed"
                        Padding="6,4" FontSize="12"/>
                <Button x:Name="BtnIEContinueDialog" Content="💬 继续提问"
                        Click="BtnIEContinueDialog_Click" IsEnabled="False"
                        Visibility="Collapsed"
                        Padding="6,4" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <!-- 文档管理区（可折叠） - RAG模式专用 -->
        <Expander Grid.Row="1" Grid.ColumnSpan="2"
                  x:Name="DocumentExpander"
                  Header="📚 文档管理"
                  IsExpanded="False"
                  Visibility="Collapsed"
                  Margin="0,8,0,8">
            <Border BorderBrush="#666666" BorderThickness="1" CornerRadius="4"
                    Padding="12" Background="#1E1E1E">
                <Grid MaxHeight="250">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部操作栏 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button x:Name="BtnUploadDocument" Content="📤 上传文档"
                                Click="BtnUploadDocument_Click" IsEnabled="False"/>
                        <TextBlock Text="支持: TXT, DOCX, PDF, JPG, PNG, BMP"
                                   VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                        <Button x:Name="BtnRefreshDocuments" Content="🔄 刷新"
                                Click="BtnRefreshDocuments_Click" IsEnabled="False"
                                Padding="6,4"/>
                        <Button x:Name="BtnDeleteAllDocuments" Content="🗑️ 清空全部"
                                Click="BtnDeleteAllDocuments_Click" IsEnabled="False"
                                Padding="6,4" Background="#8B0000" Foreground="White"/>
                        <TextBlock x:Name="LblDocumentStats" Text="📊 0文档 | 0块 | 0OCR"
                                   VerticalAlignment="Center" Foreground="#4CAF50"
                                   Margin="12,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- 文档列表 -->
                    <ListView x:Name="DocumentListView" Grid.Row="1"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2D2D2D" CornerRadius="4" Padding="8,6" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 文件名 -->
                                        <TextBlock Grid.Column="0" Text="{Binding Filename}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding Filename}"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"/>

                                        <!-- 类型 -->
                                        <TextBlock Grid.Column="1" Text="{Binding FileType}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#90CAF9"/>

                                        <!-- 大小 -->
                                        <TextBlock Grid.Column="2" Text="{Binding FileSizeDisplay}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="#FFE082"/>

                                        <!-- 块数 -->
                                        <TextBlock Grid.Column="3" Text="{Binding TotalChunks}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#A5D6A7"/>

                                        <!-- OCR -->
                                        <TextBlock Grid.Column="4" Text="{Binding OcrBadge}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="LimeGreen"
                                                   FontWeight="Bold"/>

                                        <!-- 上传时间 -->
                                        <TextBlock Grid.Column="5" Text="{Binding UploadTimeDisplay}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#BDBDBD"
                                                   FontSize="11"/>

                                        <!-- 删除按钮 -->
                                        <Button Grid.Column="6" Content="🗑️"
                                                Click="BtnDeleteDocument_Click"
                                                Tag="{Binding DocId}"
                                                Padding="6,2"
                                                FontSize="14"
                                                Background="#D32F2F"
                                                Foreground="White"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="删除文档"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 底部提示 -->
                    <TextBlock Grid.Row="2" Margin="0,8,0,0"
                               FontSize="11" Foreground="Gray"
                               Text="💡 提示：上传的文档会自动分块并生成向量，用于 RAG 检索"/>
                </Grid>
            </Border>
        </Expander>

        <!-- 中间输出：左右分栏 -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：转录输出 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="📝 转录输出" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="OutputBox" Grid.Row="1"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"/>
            </Grid>

            <!-- 分隔线 -->
            <Border Grid.Column="1" Background="Gray" Opacity="0.3"/>

            <!-- 右侧：Granite 对话区 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="💬 AI 对话" FontWeight="Bold" Margin="0,0,0,4"/>

                <!-- 对话历史（美化版） -->
                <ListView x:Name="ChatHistoryList" Grid.Row="1"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="ContextFlyout">
                                <Setter.Value>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="复制" Icon="Copy" Click="CopyMessage_Click"/>
                                    </MenuFlyout>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <!-- 用户消息（右对齐，深蓝色气泡） -->
                                <Border Visibility="{Binding IsUserVisible}"
                                        Background="#1976D2"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        HorizontalAlignment="Right"
                                        MaxWidth="400">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   Foreground="White"
                                                   IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="{Binding DisplayTime}"
                                                   FontSize="10"
                                                   Foreground="#BBDEFB"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- AI 消息（左对齐，深灰色气泡） -->
                                <Border Visibility="{Binding IsAssistantVisible}"
                                        Background="#455A64"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        HorizontalAlignment="Left"
                                        MaxWidth="400">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   Foreground="White"
                                                   IsTextSelectionEnabled="True"/>

                                        <!-- RAG 引用列表 -->
                                        <ItemsControl ItemsSource="{Binding Citations}"
                                                      Visibility="{Binding HasCitations}"
                                                      Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#37474F"
                                                            CornerRadius="6"
                                                            Padding="8,4"
                                                            Margin="0,2">
                                                        <StackPanel>
                                                            <TextBlock Foreground="#FFD54F"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold">
                                                                <Run Text="📎 "/>
                                                                <Run Text="{Binding SourceDisplay}"/>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding ChunkText}"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="#CFD8DC"
                                                                       FontSize="10"
                                                                       Margin="0,2,0,0"
                                                                       MaxLines="2"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Foreground="#90A4AE"
                                                                       FontSize="9"
                                                                       Margin="0,2,0,0">
                                                                <Run Text="相似度: "/>
                                                                <Run Text="{Binding SimilarityDisplay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding DisplayTime}"
                                                   FontSize="10"
                                                   Foreground="#B0BEC5"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 模式选择 -->
                <StackPanel Grid.Row="2" Margin="0,8,0,4">
                    <TextBlock Text="回答模式" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton x:Name="RbSimple" Content="简单" GroupName="AnswerMode">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="用通俗易懂的语言，像给外行人解释一样"/>
                            </ToolTipService.ToolTip>
                        </RadioButton>
                        <RadioButton x:Name="RbNormal" Content="普通" GroupName="AnswerMode" IsChecked="True">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="用清晰准确的语言，正常理性的表达"/>
                            </ToolTipService.ToolTip>
                        </RadioButton>
                        <RadioButton x:Name="RbProfessional" Content="专业" GroupName="AnswerMode">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="使用专业术语，假设用户有相关领域知识"/>
                            </ToolTipService.ToolTip>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>

                <!-- 参数控制 -->
                <Grid Grid.Row="3" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="创造性:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbTemperature" Grid.Column="1"
                              SelectedIndex="1" Margin="4,0">
                        <ToolTipService.ToolTip>
                            <ToolTip>
                                <StackPanel MaxWidth="250">
                                    <TextBlock FontWeight="Bold" Text="创造性（Temperature）"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                                        • 0.1-0.3：精确、一致（事实查询）
                                        • 0.5-0.7：平衡、自然（日常对话）
                                        • 0.8-1.0：创意、多样（创作内容）
                                    </TextBlock>
                                </StackPanel>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                        <ComboBoxItem Content="0.1 精确"/>
                        <ComboBoxItem Content="0.3 保守"/>
                        <ComboBoxItem Content="0.7 平衡"/>
                        <ComboBoxItem Content="0.9 创意"/>
                    </ComboBox>

                    <TextBlock Grid.Column="2" Text="长度:"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <ComboBox x:Name="CmbMaxTokens" Grid.Column="3"
                              SelectedIndex="3" Margin="4,0">
                        <ToolTipService.ToolTip>
                            <ToolTip>
                                <StackPanel MaxWidth="250">
                                    <TextBlock FontWeight="Bold" Text="回答长度（Max Tokens）"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                                        • 128: ~60字 (超简短)
                                        • 512: ~250字 (简短)
                                        • 1024: ~500字 (正常)
                                        • 2048: ~1000字 (详细，推荐)
                                        • 4096: ~2000字 (很详细)
                                    </TextBlock>
                                </StackPanel>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                        <ComboBoxItem Content="128 超简短"/>
                        <ComboBoxItem Content="512 简短"/>
                        <ComboBoxItem Content="1024 正常"/>
                        <ComboBoxItem Content="2048 详细"/>
                        <ComboBoxItem Content="4096 很详细"/>
                    </ComboBox>
                </Grid>

                <!-- 输入框 -->
                <TextBox x:Name="TxtGraniteInput" Grid.Row="4"
                         PlaceholderText="输入问题（Ctrl+Enter 发送）..."
                         TextWrapping="Wrap" AcceptsReturn="True"
                         PreviewKeyDown="TxtGraniteInput_PreviewKeyDown"/>

                <!-- 发送按钮 -->
                <Button x:Name="BtnGraniteSend" Grid.Row="5"
                        Content="📤 发送 (Ctrl+Enter)"
                        Click="BtnGraniteSend_Click"
                        HorizontalAlignment="Stretch"
                        Margin="0,4,0,0"
                        IsEnabled="False"/>
            </Grid>

            <!-- 右侧：LLaVA 视觉问答区（默认隐藏） -->
            <Grid Grid.Column="2" x:Name="LLaVAPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="🖼️ 视觉问答" FontWeight="Bold" Margin="0,0,0,4"/>

                <!-- 图片预览区 -->
                <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1"
                        CornerRadius="4" Margin="0,4"
                        AllowDrop="True"
                        DragOver="ImgPreview_DragOver"
                        Drop="ImgPreview_Drop">
                    <Grid>
                        <Image x:Name="ImgPreview" Stretch="Uniform"/>
                        <TextBlock Text="拖拽图片到此处&#x0a;或点击上传按钮"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="Gray"
                                   FontSize="14"
                                   x:Name="ImgPlaceholder"/>
                    </Grid>
                </Border>

                <!-- 图片上传控制 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,4">
                    <Button x:Name="BtnLoadLLaVA" Content="🚀 加载LLaVA模型"
                            Click="BtnLoadLLaVA_Click" IsEnabled="True"
                            Background="#FF4CAF50" Foreground="White"/>
                    <Button x:Name="BtnUploadImage" Content="📤 上传图片"
                            Click="BtnUploadImage_Click" IsEnabled="False"/>
                    <TextBlock x:Name="LblImageStatus" Text="未加载图片"
                               VerticalAlignment="Center" Foreground="Gray"/>
                    <TextBlock x:Name="LblLLaVAStatus" Text="⚠️ 未加载模型"
                               VerticalAlignment="Center" Foreground="Orange" FontWeight="Bold"/>
                </StackPanel>

                <!-- 模式切换 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,4">
                    <Button x:Name="BtnLLaVASingle" Content="🔄 单轮模式"
                            Click="BtnLLaVASingle_Click" IsEnabled="False"/>
                    <Button x:Name="BtnLLaVAMulti" Content="💬 多轮模式"
                            Click="BtnLLaVAMulti_Click" IsEnabled="False"/>
                    <Button x:Name="BtnLLaVAClear" Content="🗑️ 清空历史"
                            Click="BtnLLaVAClear_Click" IsEnabled="False"/>
                    <TextBlock x:Name="LblLLaVAMode" Text="[单轮模式]"
                               VerticalAlignment="Center" Foreground="Gray"/>
                </StackPanel>

                <!-- LLaVA 对话历史 -->
                <ListView x:Name="LLaVAChatList" Grid.Row="4"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="None"
                          Margin="0,4">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <!-- 用户消息（右对齐） -->
                                <Border Visibility="{Binding IsUserVisible}"
                                        Background="#1976D2"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        HorizontalAlignment="Right"
                                        MaxWidth="400">
                                    <TextBlock Text="{Binding Content}"
                                               TextWrapping="Wrap"
                                               Foreground="White"
                                               IsTextSelectionEnabled="True"/>
                                </Border>

                                <!-- AI 消息（左对齐） -->
                                <Border Visibility="{Binding IsAssistantVisible}"
                                        Background="#455A64"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        HorizontalAlignment="Left"
                                        MaxWidth="400">
                                    <TextBlock Text="{Binding Content}"
                                               TextWrapping="Wrap"
                                               Foreground="White"
                                               IsTextSelectionEnabled="True"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- LLaVA 参数控制 -->
                <Grid Grid.Row="5" Margin="0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="创造性:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbLLaVATemperature" Grid.Column="1"
                              SelectedIndex="1" Margin="4,0">
                        <ComboBoxItem Content="0.1 精确"/>
                        <ComboBoxItem Content="0.7 平衡"/>
                        <ComboBoxItem Content="0.9 创意"/>
                    </ComboBox>

                    <TextBlock Grid.Column="2" Text="长度:"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <ComboBox x:Name="CmbLLaVAMaxTokens" Grid.Column="3"
                              SelectedIndex="1" Margin="4,0">
                        <ComboBoxItem Content="256 简短"/>
                        <ComboBoxItem Content="512 正常"/>
                        <ComboBoxItem Content="1024 详细"/>
                    </ComboBox>

                    <!-- 输入框 -->
                    <TextBox x:Name="TxtLLaVAInput" Grid.Row="1" Grid.ColumnSpan="4"
                             PlaceholderText="输入关于图片的问题..."
                             TextWrapping="Wrap"
                             Margin="0,4,0,0"/>
                </Grid>

                <!-- 发送按钮 -->
                <Button x:Name="BtnLLaVASend" Grid.Row="6"
                        Content="📤 发送"
                        Click="BtnLLaVASend_Click"
                        HorizontalAlignment="Stretch"
                        Margin="0,4,0,0"
                        IsEnabled="False"/>
            </Grid>
        </Grid>

        <!-- 底部状态 -->
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                   Text="离线模式：开启 | Whisper 集成测试" Opacity="0.8"/>
    </Grid>
</Window>
