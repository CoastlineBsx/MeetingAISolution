<Window
    x:Class="MeetingAI.Host.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Meeting AI (Local)">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 自定义标题栏 (48px 高度以容纳搜索框) -->
        <Grid x:Name="CustomTitleBar"
              Grid.Row="0"
              Background="Transparent"
              Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：图标 + 标题 -->
            <StackPanel Grid.Column="0"
                       Orientation="Horizontal"
                       VerticalAlignment="Center"
                       Margin="16,0,0,0">
                <!-- 应用图标 (16x16) -->
                <FontIcon Glyph="&#xE8F2;"
                         FontSize="16"
                         Margin="0,0,16,0"/>

                <!-- 应用标题 (Segoe UI Variable, Caption 样式) -->
                <TextBlock x:Name="AppTitleTextBlock"
                          Text="Meeting AI (Local)"
                          Style="{StaticResource CaptionTextBlockStyle}"
                          VerticalAlignment="Center"
                          TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- 中央：搜索框 -->
            <AutoSuggestBox x:Name="SearchBox"
                           Grid.Column="1"
                           PlaceholderText="搜索功能..."
                           QueryIcon="Find"
                           Width="400"
                           Height="32"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextChanged="SearchBox_TextChanged"
                           QuerySubmitted="SearchBox_QuerySubmitted"/>

            <!-- 右侧：为系统按钮预留空间 (由 Windows 自动管理) -->
        </Grid>

        <!-- NavigationView (占据剩余空间) -->
        <NavigationView x:Name="NavView"
                        Grid.Row="1"
                        PaneDisplayMode="Left"
                        IsBackButtonVisible="Collapsed"
                        IsSettingsVisible="True"
                        SelectionChanged="NavView_SelectionChanged">

        <NavigationView.MenuItems>
            <NavigationViewItem Icon="Home" Content="主页" Tag="home" IsSelected="True">
                <ToolTipService.ToolTip>
                    <ToolTip Content="Worker 控制、模型加载、录音转录"/>
                </ToolTipService.ToolTip>
            </NavigationViewItem>

            <NavigationViewItem Content="Startup &amp; Model Init" Tag="startup">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE7E8;"/>
                </NavigationViewItem.Icon>
                <ToolTipService.ToolTip>
                    <ToolTip Content="Startup and Model Initialization"/>
                </ToolTipService.ToolTip>
            </NavigationViewItem>

            <NavigationViewItem Content="Intelligent Chat" Tag="chat">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8F2;"/>
                </NavigationViewItem.Icon>
                <ToolTipService.ToolTip>
                    <ToolTip Content="General AI conversation assistant with multi-turn dialogue support"/>
                </ToolTipService.ToolTip>
            </NavigationViewItem>

            <NavigationViewItem Content="Document Assistant" Tag="quickqa">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8A5;"/>
                </NavigationViewItem.Icon>
                <ToolTipService.ToolTip>
                    <ToolTip Content="Upload documents for quick Q&amp;A without building a knowledge base"/>
                </ToolTipService.ToolTip>
            </NavigationViewItem>

            <NavigationViewItem Content="智能解析" Tag="ie">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE721;"/>
                </NavigationViewItem.Icon>
                <ToolTipService.ToolTip>
                    <ToolTip Content="从文档中提取结构化信息（合同、发票等）"/>
                </ToolTipService.ToolTip>
            </NavigationViewItem>

            <NavigationViewItem Content="知识库" Tag="rag">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE8F1;"/>
                </NavigationViewItem.Icon>
                <ToolTipService.ToolTip>
                    <ToolTip Content="基于向量检索的知识库问答系统"/>
                </ToolTipService.ToolTip>
            </NavigationViewItem>

            <NavigationViewItem Content="视觉理解" Tag="llava">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xEB9F;"/>
                </NavigationViewItem.Icon>
                <ToolTipService.ToolTip>
                    <ToolTip Content="图像识别与视觉问答"/>
                </ToolTipService.ToolTip>
            </NavigationViewItem>

            <NavigationViewItem Content="图像生成" Tag="sd">
                <NavigationViewItem.Icon>
                    <FontIcon Glyph="&#xE771;"/>
                </NavigationViewItem.Icon>
                <ToolTipService.ToolTip>
                    <ToolTip Content="AI 图像生成 (Stable Diffusion)"/>
                </ToolTipService.ToolTip>
            </NavigationViewItem>
        </NavigationView.MenuItems>

        <NavigationView.FooterMenuItems>
            <NavigationViewItem Icon="Help" Content="帮助" Tag="help">
                <ToolTipService.ToolTip>
                    <ToolTip Content="使用帮助和文档"/>
                </ToolTipService.ToolTip>
            </NavigationViewItem>
        </NavigationView.FooterMenuItems>

        <NavigationView.Content>
            <Grid>
                <!-- 主页 -->
                <Grid x:Name="HomePage" Padding="16" Visibility="Visible">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 顶部按钮区 - 3行布局 -->
        <StackPanel Grid.ColumnSpan="2" Spacing="8">
            <!-- 第一行：基础控制 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="BtnStart" Content="启动 Worker" Click="BtnStart_Click"/>
                <Button x:Name="BtnPing"  Content="发送测试消息" Click="BtnPing_Click" IsEnabled="False"/>

                <!-- 测试转录组 -->
                <Button x:Name="BtnTranscribe" Content="测试转录" Click="BtnTranscribe_Click" IsEnabled="False"/>
                <ComboBox x:Name="CmbTranscribeMode" SelectedIndex="0" MinWidth="120" VerticalAlignment="Center">
                    <ComboBoxItem Content="🎤 对话/会议"/>
                    <ComboBoxItem Content="🎵 音乐/歌曲"/>
                    <ComboBoxItem Content="🎭 混合模式"/>
                </ComboBox>
                <ComboBox x:Name="CmbTranscribeLanguage" SelectedIndex="0" MinWidth="100" VerticalAlignment="Center">
                    <ComboBoxItem Content="🌐 自动"/>
                    <ComboBoxItem Content="🇨🇳 中文"/>
                    <ComboBoxItem Content="🇺🇸 英语"/>
                    <ComboBoxItem Content="🇯🇵 日语"/>
                    <ComboBoxItem Content="🇰🇷 韩语"/>
                    <ComboBoxItem Content="🇪🇸 西班牙语"/>
                    <ComboBoxItem Content="🇫🇷 法语"/>
                    <ComboBoxItem Content="🇩🇪 德语"/>
                </ComboBox>

                <Button x:Name="BtnStop"  Content="停止 Worker" Click="BtnStop_Click" IsEnabled="False"/>
                <Button x:Name="BtnTestEmbedding" Content="🧪 测试Embedding" Click="BtnTestEmbedding_Click" IsEnabled="False"/>
                <Button x:Name="BtnTestSimilarity" Content="🔍 诊断相似度" Click="BtnTestSimilarity_Click" IsEnabled="False"/>
                <TextBlock x:Name="LblStatus" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- 第二行：音频捕获功能 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- 扬声器转录组 -->
                <Button x:Name="BtnLoopback" Content="🔊 扬声器转录" Click="BtnLoopback_Click" IsEnabled="False"/>
                <ComboBox x:Name="CmbLoopbackDevice" SelectedIndex="0" MinWidth="180" VerticalAlignment="Center" SelectionChanged="CmbLoopbackDevice_SelectionChanged">
                    <ComboBoxItem Content="[默认扬声器]" Tag="default"/>
                </ComboBox>
                <ComboBox x:Name="CmbLoopbackMode" SelectedIndex="0" MinWidth="120" VerticalAlignment="Center">
                    <ComboBoxItem Content="🎤 对话/会议"/>
                    <ComboBoxItem Content="🎵 音乐/歌曲"/>
                    <ComboBoxItem Content="🎭 混合模式"/>
                </ComboBox>
                <ComboBox x:Name="CmbLoopbackLanguage" SelectedIndex="0" MinWidth="100" VerticalAlignment="Center">
                    <ComboBoxItem Content="🌐 自动"/>
                    <ComboBoxItem Content="🇨🇳 中文"/>
                    <ComboBoxItem Content="🇺🇸 英语"/>
                    <ComboBoxItem Content="🇯🇵 日语"/>
                    <ComboBoxItem Content="🇰🇷 韩语"/>
                    <ComboBoxItem Content="🇪🇸 西班牙语"/>
                    <ComboBoxItem Content="🇫🇷 法语"/>
                    <ComboBoxItem Content="🇩🇪 德语"/>
                </ComboBox>

                <!-- 麦克风转录组 -->
                <Button x:Name="BtnMicrophone" Content="🎤 麦克风转录" Click="BtnMicrophone_Click" IsEnabled="False"/>
                <ComboBox x:Name="CmbMicrophoneDevice" SelectedIndex="0" MinWidth="150" VerticalAlignment="Center" SelectionChanged="CmbMicrophoneDevice_SelectionChanged">
                    <ComboBoxItem Content="[默认麦克风]" Tag="default"/>
                </ComboBox>
                <ComboBox x:Name="CmbMicrophoneMode" SelectedIndex="0" MinWidth="120" VerticalAlignment="Center">
                    <ComboBoxItem Content="🎤 对话/会议"/>
                    <ComboBoxItem Content="🎵 音乐/歌曲"/>
                    <ComboBoxItem Content="🎭 混合模式"/>
                </ComboBox>
                <ComboBox x:Name="CmbMicrophoneLanguage" SelectedIndex="0" MinWidth="100" VerticalAlignment="Center">
                    <ComboBoxItem Content="🌐 自动"/>
                    <ComboBoxItem Content="🇨🇳 中文"/>
                    <ComboBoxItem Content="🇺🇸 英语"/>
                    <ComboBoxItem Content="🇯🇵 日语"/>
                    <ComboBoxItem Content="🇰🇷 韩语"/>
                    <ComboBoxItem Content="🇪🇸 西班牙语"/>
                    <ComboBoxItem Content="🇫🇷 法语"/>
                    <ComboBoxItem Content="🇩🇪 德语"/>
                </ComboBox>

            </StackPanel>

            <!-- 第三行：综合模式转录功能 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- 综合模式转录组（方案B：定时器同步）-->
                <Button x:Name="BtnMeeting" Content="📞 综合转录" Click="BtnMeeting_Click" IsEnabled="False"/>
                <ComboBox x:Name="CmbMeetingSpeakerDevice" SelectedIndex="0" MinWidth="180" VerticalAlignment="Center" SelectionChanged="CmbMeetingSpeakerDevice_SelectionChanged">
                    <ComboBoxItem Content="[默认扬声器]" Tag="default"/>
                </ComboBox>
                <ComboBox x:Name="CmbMeetingDevice" SelectedIndex="0" MinWidth="150" VerticalAlignment="Center" SelectionChanged="CmbMeetingDevice_SelectionChanged">
                    <ComboBoxItem Content="[默认麦克风]" Tag="default"/>
                </ComboBox>
                <ComboBox x:Name="CmbMeetingMode" SelectedIndex="0" MinWidth="120" VerticalAlignment="Center">
                    <ComboBoxItem Content="🎤 对话/会议"/>
                    <ComboBoxItem Content="🎵 音乐/歌曲"/>
                    <ComboBoxItem Content="🎭 混合模式"/>
                </ComboBox>
                <ComboBox x:Name="CmbMeetingLanguage" SelectedIndex="0" MinWidth="100" VerticalAlignment="Center">
                    <ComboBoxItem Content="🌐 自动"/>
                    <ComboBoxItem Content="🇨🇳 中文"/>
                    <ComboBoxItem Content="🇺🇸 英语"/>
                    <ComboBoxItem Content="🇯🇵 日语"/>
                    <ComboBoxItem Content="🇰🇷 韩语"/>
                    <ComboBoxItem Content="🇪🇸 西班牙语"/>
                    <ComboBoxItem Content="🇫🇷 法语"/>
                    <ComboBoxItem Content="🇩🇪 德语"/>
                </ComboBox>

                <!-- 综合模式（beta）转录组（方案A：事后对齐）-->
                <Button x:Name="BtnMeetingBeta" Content="📞 综合转录Beta" Click="BtnMeetingBeta_Click" IsEnabled="False"/>
                <ComboBox x:Name="CmbMeetingBetaSpeakerDevice" SelectedIndex="0" MinWidth="180" VerticalAlignment="Center" SelectionChanged="CmbMeetingBetaSpeakerDevice_SelectionChanged">
                    <ComboBoxItem Content="[默认扬声器]" Tag="default"/>
                </ComboBox>
                <ComboBox x:Name="CmbMeetingBetaDevice" SelectedIndex="0" MinWidth="150" VerticalAlignment="Center" SelectionChanged="CmbMeetingBetaDevice_SelectionChanged">
                    <ComboBoxItem Content="[默认麦克风]" Tag="default"/>
                </ComboBox>
                <ComboBox x:Name="CmbMeetingBetaMode" SelectedIndex="0" MinWidth="120" VerticalAlignment="Center">
                    <ComboBoxItem Content="🎤 对话/会议"/>
                    <ComboBoxItem Content="🎵 音乐/歌曲"/>
                    <ComboBoxItem Content="🎭 混合模式"/>
                </ComboBox>
                <ComboBox x:Name="CmbMeetingBetaLanguage" SelectedIndex="0" MinWidth="100" VerticalAlignment="Center">
                    <ComboBoxItem Content="🌐 自动"/>
                    <ComboBoxItem Content="🇨🇳 中文"/>
                    <ComboBoxItem Content="🇺🇸 英语"/>
                    <ComboBoxItem Content="🇯🇵 日语"/>
                    <ComboBoxItem Content="🇰🇷 韩语"/>
                    <ComboBoxItem Content="🇪🇸 西班牙语"/>
                    <ComboBoxItem Content="🇫🇷 法语"/>
                    <ComboBoxItem Content="🇩🇪 德语"/>
                </ComboBox>
            </StackPanel>

            <!-- 第四行：综合转录Beta2 + 流式转录 -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <!-- 综合模式（beta2）转录组 -->
                <Button x:Name="BtnMeetingBeta2" Content="📞 综合转录Beta2" Click="BtnMeetingBeta2_Click" IsEnabled="False"/>
                <ComboBox x:Name="CmbMeetingBeta2SpeakerDevice" SelectedIndex="0" MinWidth="180" VerticalAlignment="Center" SelectionChanged="CmbMeetingBeta2SpeakerDevice_SelectionChanged">
                    <ComboBoxItem Content="[默认扬声器]" Tag="default"/>
                </ComboBox>
                <ComboBox x:Name="CmbMeetingBeta2Device" SelectedIndex="0" MinWidth="150" VerticalAlignment="Center" SelectionChanged="CmbMeetingBeta2Device_SelectionChanged">
                    <ComboBoxItem Content="[默认麦克风]" Tag="default"/>
                </ComboBox>
                <ComboBox x:Name="CmbMeetingBeta2Mode" SelectedIndex="0" MinWidth="120" VerticalAlignment="Center">
                    <ComboBoxItem Content="🎤 对话/会议"/>
                    <ComboBoxItem Content="🎵 音乐/歌曲"/>
                    <ComboBoxItem Content="🎭 混合模式"/>
                </ComboBox>
                <ComboBox x:Name="CmbMeetingBeta2Language" SelectedIndex="0" MinWidth="100" VerticalAlignment="Center">
                    <ComboBoxItem Content="🌐 自动"/>
                    <ComboBoxItem Content="🇨🇳 中文"/>
                    <ComboBoxItem Content="🇺🇸 英语"/>
                    <ComboBoxItem Content="🇯🇵 日语"/>
                    <ComboBoxItem Content="🇰🇷 韩语"/>
                    <ComboBoxItem Content="🇪🇸 西班牙语"/>
                    <ComboBoxItem Content="🇫🇷 法语"/>
                    <ComboBoxItem Content="🇩🇪 德语"/>
                </ComboBox>
            </StackPanel>

            <!-- 第五行：Granite AI 对话控制 -->
            <!-- 第一行：全局控制（单轮/多轮/清空历史） -->
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="💬 AI 对话：" VerticalAlignment="Center" FontWeight="Bold"/>
                <Button x:Name="BtnGraniteSingle" Content="🔄 单轮模式"
                        Click="BtnGraniteSingle_Click" IsEnabled="False"/>
                <Button x:Name="BtnGraniteMulti" Content="💬 多轮模式"
                        Click="BtnGraniteMulti_Click" IsEnabled="False"/>
                <Button x:Name="BtnGraniteClear" Content="🗑️ 清空历史"
                        Click="BtnGraniteClear_Click" IsEnabled="False"/>
                <TextBlock x:Name="LblGraniteMode" Text="[单轮模式]"
                           VerticalAlignment="Center" Foreground="Gray"/>
            </StackPanel>

            <!-- 第二行：4个对话模式选择 -->
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="    " VerticalAlignment="Center"/>
                <Button x:Name="BtnQuickQA" Content="⚡ 快速问答"
                        Click="BtnQuickQA_Click" IsEnabled="False"
                        Padding="8,4"/>
                <Button x:Name="BtnIEMode" Content="🔍 IE模式"
                        Click="BtnIEMode_Click" IsEnabled="False"
                        Padding="8,4"/>
                <Button x:Name="BtnRAGMode" Content="📚 RAG模式"
                        Click="BtnRAGMode_Click" IsEnabled="False"
                        Padding="8,4"/>
                <Button x:Name="BtnLLaVAMode" Content="🖼️ 视觉问答"
                        Click="BtnLLaVAMode_Click" IsEnabled="False"
                        Padding="8,4"/>
            </StackPanel>

            <!-- 第三行：动态显示区域 -->
            <StackPanel x:Name="ModeContentArea" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <TextBlock Text="    " VerticalAlignment="Center"/>
                <!-- 状态文字在前 -->
                <TextBlock x:Name="LblModeStatus" Text=""
                           VerticalAlignment="Center" Foreground="Gray"/>

                <!-- RAG 模式专用按钮（默认隐藏） -->
                <Button x:Name="BtnRAGTest2" Content="🧪 添加测试文档"
                        Click="BtnRAGTest_Click" IsEnabled="False"
                        Visibility="Collapsed"
                        Padding="6,4" FontSize="12"/>
                <Button x:Name="BtnDocumentManage2" Content="📚 文档管理"
                        Click="BtnDocumentManage_Click" IsEnabled="False"
                        Visibility="Collapsed"
                        Padding="6,4" FontSize="12"/>

                <!-- IE 模式专用控件（默认隐藏） -->
                <Button x:Name="BtnIELoad2" Content="📎 加载文件"
                        Click="BtnIELoad_Click" IsEnabled="False"
                        Visibility="Collapsed"
                        Padding="6,4" FontSize="12"/>
                <ComboBox x:Name="CmbIETemplate2"
                          SelectionChanged="CmbIETemplate_SelectionChanged"
                          IsEnabled="False"
                          Visibility="Collapsed"
                          MinWidth="150" FontSize="12">
                    <!-- 模板选项会在代码中动态填充 -->
                </ComboBox>
                <TextBlock x:Name="LblIEDoc2" Text="未加载文档"
                           VerticalAlignment="Center" Foreground="Gray" FontSize="12"
                           Visibility="Collapsed"/>
                <Button x:Name="BtnIEExtract2" Content="▶️ 开始提取"
                        Click="BtnIEExtract_Click" IsEnabled="False"
                        Visibility="Collapsed"
                        Padding="6,4" FontSize="12"/>
                <TextBlock x:Name="LblIEStatus2" Text=""
                           VerticalAlignment="Center" Foreground="Gray" FontSize="12"
                           Visibility="Collapsed"/>
                <Button x:Name="BtnIECopyJSON2" Content="📋 复制JSON"
                        Click="BtnIECopyJSON_Click" IsEnabled="False"
                        Visibility="Collapsed"
                        Padding="6,4" FontSize="12"/>
                <Button x:Name="BtnIEExport2" Content="💾 导出"
                        Click="BtnIEExport_Click" IsEnabled="False"
                        Visibility="Collapsed"
                        Padding="6,4" FontSize="12"/>
                <Button x:Name="BtnIEReExtract2" Content="🔄 重新提取"
                        Click="BtnIEReExtract_Click" IsEnabled="False"
                        Visibility="Collapsed"
                        Padding="6,4" FontSize="12"/>
                <Button x:Name="BtnIEContinueDialog2" Content="💬 继续提问"
                        Click="BtnIEContinueDialog_Click" IsEnabled="False"
                        Visibility="Collapsed"
                        Padding="6,4" FontSize="12"/>
            </StackPanel>
        </StackPanel>

        <!-- 文档管理区（可折叠） - RAG模式专用 -->
        <Expander Grid.Row="1" Grid.ColumnSpan="2"
                  x:Name="DocumentExpander"
                  Header="📚 文档管理"
                  IsExpanded="False"
                  Visibility="Collapsed"
                  Margin="0,8,0,8">
            <Border BorderBrush="#666666" BorderThickness="1" CornerRadius="4"
                    Padding="12" Background="#1E1E1E">
                <Grid MaxHeight="250">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 顶部操作栏 -->
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button x:Name="BtnUploadDocument" Content="📤 上传文档"
                                Click="BtnUploadDocument_Click" IsEnabled="False"/>
                        <TextBlock Text="支持: TXT, DOCX, PDF, JPG, PNG, BMP"
                                   VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                        <Button x:Name="BtnRefreshDocuments" Content="🔄 刷新"
                                Click="BtnRefreshDocuments_Click" IsEnabled="False"
                                Padding="6,4"/>
                        <Button x:Name="BtnDeleteAllDocuments" Content="🗑️ 清空全部"
                                Click="BtnDeleteAllDocuments_Click" IsEnabled="False"
                                Padding="6,4" Background="#8B0000" Foreground="White"/>
                        <TextBlock x:Name="LblDocumentStats" Text="📊 0文档 | 0块 | 0OCR"
                                   VerticalAlignment="Center" Foreground="#4CAF50"
                                   Margin="12,0,0,0" FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- 文档列表 -->
                    <ListView x:Name="DocumentListView" Grid.Row="1"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#2D2D2D" CornerRadius="4" Padding="8,6" Margin="0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="50"/>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- 文件名 -->
                                        <TextBlock Grid.Column="0" Text="{Binding Filename}"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTipService.ToolTip="{Binding Filename}"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"/>

                                        <!-- 类型 -->
                                        <TextBlock Grid.Column="1" Text="{Binding FileType}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#90CAF9"/>

                                        <!-- 大小 -->
                                        <TextBlock Grid.Column="2" Text="{Binding FileSizeDisplay}"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="#FFE082"/>

                                        <!-- 块数 -->
                                        <TextBlock Grid.Column="3" Text="{Binding TotalChunks}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#A5D6A7"/>

                                        <!-- OCR -->
                                        <TextBlock Grid.Column="4" Text="{Binding OcrBadge}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="LimeGreen"
                                                   FontWeight="Bold"/>

                                        <!-- 上传时间 -->
                                        <TextBlock Grid.Column="5" Text="{Binding UploadTimeDisplay}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="#BDBDBD"
                                                   FontSize="11"/>

                                        <!-- 删除按钮 -->
                                        <Button Grid.Column="6" Content="🗑️"
                                                Click="BtnDeleteDocument_Click"
                                                Tag="{Binding DocId}"
                                                Padding="6,2"
                                                FontSize="14"
                                                Background="#D32F2F"
                                                Foreground="White"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTipService.ToolTip="删除文档"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 底部提示 -->
                    <TextBlock Grid.Row="2" Margin="0,8,0,0"
                               FontSize="11" Foreground="Gray"
                               Text="💡 提示：上传的文档会自动分块并生成向量，用于 RAG 检索"/>
                </Grid>
            </Border>
        </Expander>

        <!-- 中间输出：左右分栏 -->
        <Grid Grid.Row="2" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：转录输出 -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="📝 转录输出" FontWeight="Bold" Margin="0,0,0,4"/>
                <TextBox x:Name="OutputBox" Grid.Row="1"
                         TextWrapping="Wrap" AcceptsReturn="True"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"/>
            </Grid>

            <!-- 分隔线 -->
            <Border Grid.Column="1" Background="Gray" Opacity="0.3"/>

            <!-- 右侧：Granite 对话区 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="100"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="💬 AI 对话" FontWeight="Bold" Margin="0,0,0,4"/>

                <!-- 对话历史（美化版） -->
                <ListView x:Name="ChatHistoryList" Grid.Row="1"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="None">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="ContextFlyout">
                                <Setter.Value>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="复制" Icon="Copy" Click="CopyMessage_Click"/>
                                    </MenuFlyout>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <!-- 用户消息（右对齐，Teams 紫蓝色） -->
                                <Border Visibility="{Binding IsUserVisible}"
                                        Background="{ThemeResource UserBubbleBackground}"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        HorizontalAlignment="Right"
                                        MaxWidth="400">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource UserBubbleText}"
                                                   IsTextSelectionEnabled="True"/>
                                        <TextBlock Text="{Binding DisplayTime}"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource UserBubbleText}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,0,0"
                                                   Opacity="0.7"/>
                                    </StackPanel>
                                </Border>

                                <!-- AI 消息（左对齐，深灰/浅灰） -->
                                <Border Visibility="{Binding IsAssistantVisible}"
                                        Background="{ThemeResource AIBubbleBackground}"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        HorizontalAlignment="Left"
                                        MaxWidth="400">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource AIBubbleText}"
                                                   IsTextSelectionEnabled="True"/>

                                        <!-- RAG 引用列表 -->
                                        <ItemsControl ItemsSource="{Binding Citations}"
                                                      Visibility="{Binding HasCitations}"
                                                      Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{ThemeResource CitationBackground}"
                                                            CornerRadius="6"
                                                            Padding="8,4"
                                                            Margin="0,2">
                                                        <StackPanel>
                                                            <TextBlock Foreground="{ThemeResource CitationAccent}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold">
                                                                <Run Text="📎 "/>
                                                                <Run Text="{Binding SourceDisplay}"/>
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding ChunkText}"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{ThemeResource AIBubbleText}"
                                                                       FontSize="10"
                                                                       Margin="0,2,0,0"
                                                                       MaxLines="2"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Opacity="0.8"/>
                                                            <TextBlock Foreground="{ThemeResource AIBubbleText}"
                                                                       FontSize="9"
                                                                       Margin="0,2,0,0"
                                                                       Opacity="0.6">
                                                                <Run Text="相似度: "/>
                                                                <Run Text="{Binding SimilarityDisplay}"/>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding DisplayTime}"
                                                   FontSize="10"
                                                   Foreground="{ThemeResource AIBubbleText}"
                                                   Margin="0,4,0,0"
                                                   Opacity="0.6"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- 模式选择 -->
                <StackPanel Grid.Row="2" Margin="0,8,0,4">
                    <TextBlock Text="回答模式" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <RadioButton x:Name="RbSimple" Content="简单" GroupName="AnswerMode">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="用通俗易懂的语言，像给外行人解释一样"/>
                            </ToolTipService.ToolTip>
                        </RadioButton>
                        <RadioButton x:Name="RbNormal" Content="普通" GroupName="AnswerMode" IsChecked="True">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="用清晰准确的语言，正常理性的表达"/>
                            </ToolTipService.ToolTip>
                        </RadioButton>
                        <RadioButton x:Name="RbProfessional" Content="专业" GroupName="AnswerMode">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="使用专业术语，假设用户有相关领域知识"/>
                            </ToolTipService.ToolTip>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>

                <!-- 参数控制 -->
                <Grid Grid.Row="3" Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="创造性:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbTemperature" Grid.Column="1"
                              SelectedIndex="1" Margin="4,0">
                        <ToolTipService.ToolTip>
                            <ToolTip>
                                <StackPanel MaxWidth="250">
                                    <TextBlock FontWeight="Bold" Text="创造性（Temperature）"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                                        • 0.1-0.3：精确、一致（事实查询）
                                        • 0.5-0.7：平衡、自然（日常对话）
                                        • 0.8-1.0：创意、多样（创作内容）
                                    </TextBlock>
                                </StackPanel>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                        <ComboBoxItem Content="0.1 精确"/>
                        <ComboBoxItem Content="0.3 聚焦"/>
                        <ComboBoxItem Content="0.7 平衡"/>
                        <ComboBoxItem Content="0.9 创意"/>
                    </ComboBox>

                    <TextBlock Grid.Column="2" Text="长度:"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <ComboBox x:Name="CmbMaxTokens" Grid.Column="3"
                              SelectedIndex="3" Margin="4,0">
                        <ToolTipService.ToolTip>
                            <ToolTip>
                                <StackPanel MaxWidth="250">
                                    <TextBlock FontWeight="Bold" Text="回答长度（Max Tokens）"/>
                                    <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">
                                        • 128: ~60字 (超简短)
                                        • 512: ~250字 (简短)
                                        • 1024: ~500字 (正常)
                                        • 2048: ~1000字 (详细，推荐)
                                        • 4096: ~2000字 (很详细)
                                    </TextBlock>
                                </StackPanel>
                            </ToolTip>
                        </ToolTipService.ToolTip>
                        <ComboBoxItem Content="128 超简短"/>
                        <ComboBoxItem Content="512 简短"/>
                        <ComboBoxItem Content="1024 正常"/>
                        <ComboBoxItem Content="2048 详细"/>
                        <ComboBoxItem Content="4096 很详细"/>
                    </ComboBox>
                </Grid>

                <!-- 输入框 -->
                <TextBox x:Name="TxtGraniteInput" Grid.Row="4"
                         PlaceholderText="输入问题（Ctrl+Enter 发送）..."
                         TextWrapping="Wrap" AcceptsReturn="True"
                         PreviewKeyDown="TxtGraniteInput_PreviewKeyDown"/>

                <!-- 发送按钮 -->
                <Button x:Name="BtnGraniteSend" Grid.Row="5"
                        Content="📤 发送 (Ctrl+Enter)"
                        Click="BtnGraniteSend_Click"
                        HorizontalAlignment="Stretch"
                        Margin="0,4,0,0"
                        IsEnabled="False"/>
            </Grid>

            <!-- 右侧：LLaVA 视觉问答区（默认隐藏） -->
            <Grid Grid.Column="2" x:Name="LLaVAPanel" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="200"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="🖼️ 视觉问答" FontWeight="Bold" Margin="0,0,0,4"/>

                <!-- 图片预览区 -->
                <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1"
                        CornerRadius="4" Margin="0,4"
                        AllowDrop="True"
                        DragOver="ImgPreview_DragOver"
                        Drop="ImgPreview_Drop">
                    <Grid>
                        <Image x:Name="ImgPreview" Stretch="Uniform"/>
                        <TextBlock Text="拖拽图片到此处&#x0a;或点击上传按钮"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextAlignment="Center"
                                   Foreground="Gray"
                                   FontSize="14"
                                   x:Name="ImgPlaceholder"/>
                    </Grid>
                </Border>

                <!-- 图片上传控制 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,4">
                    <Button x:Name="BtnUploadImage" Content="📤 上传图片"
                            Click="BtnUploadImage_Click" IsEnabled="False"/>
                    <Button x:Name="BtnDeleteImage" Content="🗑️ 删除图片"
                            Click="BtnDeleteImage_Click" IsEnabled="False"
                            Background="#FFF44336" Foreground="White"/>
                    <TextBlock x:Name="LblImageStatus" Text="未加载图片"
                               VerticalAlignment="Center" Foreground="Gray"/>
                </StackPanel>

                <!-- 模式切换 -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,4">
                    <Button x:Name="BtnLLaVASingle" Content="🔄 单轮模式"
                            Click="BtnLLaVASingle_Click" IsEnabled="False"/>
                    <Button x:Name="BtnLLaVAMulti" Content="💬 多轮模式"
                            Click="BtnLLaVAMulti_Click" IsEnabled="False"/>
                    <Button x:Name="BtnLLaVAClear" Content="🗑️ 清空历史"
                            Click="BtnLLaVAClear_Click" IsEnabled="False"/>
                    <TextBlock x:Name="LblLLaVAMode" Text="[单轮模式]"
                               VerticalAlignment="Center" Foreground="Gray"/>
                </StackPanel>

                <!-- LLaVA 对话历史 -->
                <ListView x:Name="LLaVAChatList" Grid.Row="4"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          SelectionMode="None"
                          Margin="0,4">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="4"/>
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,2">
                                <!-- 用户消息（右对齐） -->
                                <Border Visibility="{Binding IsUserVisible}"
                                        Background="#1976D2"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        HorizontalAlignment="Right"
                                        MaxWidth="400">
                                    <TextBlock Text="{Binding Content}"
                                               TextWrapping="Wrap"
                                               Foreground="White"
                                               IsTextSelectionEnabled="True"/>
                                </Border>

                                <!-- AI 消息（左对齐） -->
                                <Border Visibility="{Binding IsAssistantVisible}"
                                        Background="#455A64"
                                        CornerRadius="12"
                                        Padding="12,8"
                                        HorizontalAlignment="Left"
                                        MaxWidth="400">
                                    <TextBlock Text="{Binding Content}"
                                               TextWrapping="Wrap"
                                               Foreground="White"
                                               IsTextSelectionEnabled="True"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!-- LLaVA 参数控制 -->
                <Grid Grid.Row="5" Margin="0,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="创造性:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbLLaVATemperature" Grid.Column="1"
                              SelectedIndex="1" Margin="4,0">
                        <ComboBoxItem Content="0.1 精确"/>
                        <ComboBoxItem Content="0.7 平衡"/>
                        <ComboBoxItem Content="0.9 创意"/>
                    </ComboBox>

                    <TextBlock Grid.Column="2" Text="长度:"
                               VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <ComboBox x:Name="CmbLLaVAMaxTokens" Grid.Column="3"
                              SelectedIndex="1" Margin="4,0">
                        <ComboBoxItem Content="256 简短"/>
                        <ComboBoxItem Content="512 正常"/>
                        <ComboBoxItem Content="1024 详细"/>
                    </ComboBox>

                    <!-- 输入框 -->
                    <TextBox x:Name="TxtLLaVAInput" Grid.Row="1" Grid.ColumnSpan="4"
                             PlaceholderText="输入关于图片的问题..."
                             TextWrapping="Wrap"
                             Margin="0,4,0,0"/>
                </Grid>

                <!-- 发送按钮 -->
                <Button x:Name="BtnLLaVASend" Grid.Row="6"
                        Content="📤 发送"
                        Click="BtnLLaVASend_Click"
                        HorizontalAlignment="Stretch"
                        Margin="0,4,0,0"
                        IsEnabled="False"/>
            </Grid>
        </Grid>

        <!-- 底部状态 -->
        <TextBlock Grid.Row="3" Grid.ColumnSpan="2"
                   Text="离线模式：开启 | Whisper 集成测试" Opacity="0.8"/>
                </Grid>

                <!-- Startup & Model Initialization Page -->
                <Grid x:Name="StartupPage" Padding="32" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Text="Startup &amp; Model Initialization" FontSize="28" FontWeight="Bold" Margin="0,0,0,32"/>

                    <!-- Model Configuration Panel -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="24" MaxWidth="900">

                            <!-- Granite & Embedding Models Group -->
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Language Models (Granite &amp; Embedding)"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Granite Device Selection -->
                                        <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,12,0">
                                            <TextBlock Text="Granite Model Device" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <ComboBox x:Name="CmbGraniteDevice"
                                                      SelectedIndex="1"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="CPU"/>
                                                <ComboBoxItem Content="GPU"/>
                                                <ComboBoxItem Content="NPU"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Embedding Device Selection -->
                                        <StackPanel Grid.Column="1" Spacing="8" Margin="12,0,0,0">
                                            <TextBlock Text="Embedding Model Device" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <ComboBox x:Name="CmbEmbeddingDevice"
                                                      SelectedIndex="1"
                                                      HorizontalAlignment="Stretch">
                                                <ComboBoxItem Content="CPU"/>
                                                <ComboBoxItem Content="GPU"/>
                                                <ComboBoxItem Content="NPU"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Load/Unload Button with ProgressRing -->
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12" Margin="0,12,0,0">
                                            <Button x:Name="BtnPreloadModels"
                                                    Content="Load Models"
                                                    Click="BtnPreloadModels_Click"
                                                    HorizontalAlignment="Stretch"
                                                    MinWidth="200"
                                                    IsEnabled="False"
                                                    Style="{ThemeResource AccentButtonStyle}"/>
                                            <ProgressRing x:Name="ProgressGraniteEmbedding"
                                                          Width="24"
                                                          Height="24"
                                                          IsActive="False"
                                                          Visibility="Collapsed"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Whisper Model Group -->
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Speech Recognition (Whisper)"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Whisper Model Device" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <ComboBox x:Name="CmbWhisperDevice"
                                                  SelectedIndex="1"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="CPU"/>
                                            <ComboBoxItem Content="GPU"/>
                                            <ComboBoxItem Content="NPU"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button x:Name="BtnLoadWhisper"
                                                Content="Load Model"
                                                Click="BtnLoadWhisper_Click"
                                                MinWidth="200"
                                                IsEnabled="False"
                                                Style="{ThemeResource AccentButtonStyle}"/>
                                        <ProgressRing x:Name="ProgressWhisper"
                                                      Width="24"
                                                      Height="24"
                                                      IsActive="False"
                                                      Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- LLaVA Model Group -->
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Vision Model (LLaVA)"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="LLaVA Model Device" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <ComboBox x:Name="CmbLLaVADevice"
                                                  SelectedIndex="1"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="CPU"/>
                                            <ComboBoxItem Content="GPU"/>
                                            <ComboBoxItem Content="NPU"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button x:Name="BtnLoadLLaVA"
                                                Content="Load Model"
                                                Click="BtnLoadLLaVA_Click"
                                                MinWidth="200"
                                                IsEnabled="False"
                                                Style="{ThemeResource AccentButtonStyle}"/>
                                        <ProgressRing x:Name="ProgressLLaVA"
                                                      Width="24"
                                                      Height="24"
                                                      IsActive="False"
                                                      Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Stable Diffusion Model Group -->
                            <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <StackPanel Spacing="16">
                                    <TextBlock Text="Image Generation (Stable Diffusion)"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>

                                    <StackPanel Spacing="8">
                                        <TextBlock Text="SD Model Device" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        <ComboBox x:Name="CmbSDDevice"
                                                  SelectedIndex="2"
                                                  HorizontalAlignment="Stretch">
                                            <ComboBoxItem Content="CPU"/>
                                            <ComboBoxItem Content="GPU"/>
                                            <ComboBoxItem Content="NPU"/>
                                        </ComboBox>
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button x:Name="BtnLoadSD"
                                                Content="Load Model"
                                                Click="BtnLoadSD_Click"
                                                MinWidth="200"
                                                IsEnabled="False"
                                                Style="{ThemeResource AccentButtonStyle}"/>
                                        <ProgressRing x:Name="ProgressSD"
                                                      Width="24"
                                                      Height="24"
                                                      IsActive="False"
                                                      Visibility="Collapsed"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- 💬 智能对话页面 -->
                <Grid x:Name="ChatPage" Padding="32" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Text="Intelligent Chat" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>

                    <!-- Configuration Panel -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="24" Margin="0,0,0,24">
                        <!-- Conversation mode -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Conversation mode" FontSize="14" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbConversationModeChat"
                                      SelectionChanged="CmbConversationMode_SelectionChanged" SelectedIndex="0"
                                      VerticalAlignment="Center">
                                <ComboBoxItem Content="Single-turn" Tag="Single"/>
                                <ComboBoxItem Content="Multi-turn" Tag="Multi"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Answer style -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Answer style" FontSize="14" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbAnswerStyleChat" SelectedIndex="1" VerticalAlignment="Center">
                                <ComboBoxItem Content="Simple" Tag="Simple"/>
                                <ComboBoxItem Content="Normal" Tag="Normal"/>
                                <ComboBoxItem Content="Professional" Tag="Professional"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Creativity -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Creativity" FontSize="14" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbTemperatureChat" SelectedIndex="2" VerticalAlignment="Center">
                                <ComboBoxItem Content="Precise" Tag="0.1"/>
                                <ComboBoxItem Content="Focused" Tag="0.3"/>
                                <ComboBoxItem Content="Balanced" Tag="0.7"/>
                                <ComboBoxItem Content="Creative" Tag="0.9"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Length -->
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="Length" FontSize="14" VerticalAlignment="Center"/>
                            <ComboBox x:Name="CmbMaxTokensChat" SelectedIndex="2" VerticalAlignment="Center">
                                <ComboBoxItem Content="Brief" Tag="512"/>
                                <ComboBoxItem Content="Normal" Tag="1024"/>
                                <ComboBoxItem Content="Detailed" Tag="2048"/>
                                <ComboBoxItem Content="Extensive" Tag="4096"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Clear history button -->
                        <Button x:Name="BtnGraniteClearChat"
                                Content="Clear history"
                                Click="BtnGraniteClear_Click"
                                VerticalAlignment="Center"
                                IsEnabled="False"/>
                    </StackPanel>

                    <!-- Chat History -->
                    <ListView x:Name="ChatHistoryListChat" Grid.Row="2"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="None"
                              Margin="0,0,0,12">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="ContextFlyout">
                                    <Setter.Value>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Copy" Icon="Copy" Click="CopyMessage_Click"/>
                                        </MenuFlyout>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <!-- 用户消息（右对齐，Teams 紫蓝色） -->
                                    <Border Visibility="{Binding IsUserVisible}"
                                            Background="{ThemeResource UserBubbleBackground}"
                                            CornerRadius="12"
                                            Padding="12,8"
                                            HorizontalAlignment="Right"
                                            MaxWidth="600">
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource UserBubbleText}"
                                                   IsTextSelectionEnabled="True"/>
                                    </Border>

                                    <!-- AI 消息（左对齐，深灰/浅灰） -->
                                    <Border Visibility="{Binding IsAssistantVisible}"
                                            Background="{ThemeResource AIBubbleBackground}"
                                            CornerRadius="12"
                                            Padding="12,8"
                                            HorizontalAlignment="Left"
                                            MaxWidth="600">
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource AIBubbleText}"
                                                   IsTextSelectionEnabled="True"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Input Box -->
                    <TextBox x:Name="TxtGraniteInputChat" Grid.Row="3"
                             PlaceholderText="Type your question (Ctrl+Enter to send)..."
                             TextWrapping="Wrap" AcceptsReturn="True"
                             PreviewKeyDown="TxtGraniteInput_PreviewKeyDown"/>

                    <!-- Send Button -->
                    <Button x:Name="BtnGraniteSendChat" Grid.Row="4"
                            Content="Send (Ctrl+Enter)"
                            Click="BtnGraniteSend_Click"
                            HorizontalAlignment="Stretch"
                            Margin="0,24,0,0"
                            IsEnabled="False"/>
                </Grid>

                <!-- 📄 文档助手页面 -->
                <!-- Document Assistant Page -->
                <Grid x:Name="QuickQAPage" Padding="32" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Text="Document Assistant" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>

                    <!-- Configuration Panel -->
                    <StackPanel Grid.Row="1" Spacing="16" Margin="0,0,0,24">
                        <!-- First Row: Answer parameters and clear history -->
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <!-- Answer style -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Answer style" FontSize="14" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbAnswerStyleQuickQA" SelectedIndex="1" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Simple" Tag="Simple"/>
                                    <ComboBoxItem Content="Normal" Tag="Normal"/>
                                    <ComboBoxItem Content="Professional" Tag="Professional"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Creativity -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Creativity" FontSize="14" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbTemperatureQuickQA" SelectedIndex="2" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Precise" Tag="0.1"/>
                                    <ComboBoxItem Content="Focused" Tag="0.3"/>
                                    <ComboBoxItem Content="Balanced" Tag="0.7"/>
                                    <ComboBoxItem Content="Creative" Tag="0.9"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Length -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Length" FontSize="14" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbMaxTokensQuickQA" SelectedIndex="2" VerticalAlignment="Center">
                                    <ComboBoxItem Content="Brief" Tag="512"/>
                                    <ComboBoxItem Content="Normal" Tag="1024"/>
                                    <ComboBoxItem Content="Detailed" Tag="2048"/>
                                    <ComboBoxItem Content="Extensive" Tag="4096"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Clear history button -->
                            <Button x:Name="BtnQuickQAClearHistory"
                                    Content="Clear history"
                                    Click="BtnQuickQAClearHistory_Click"
                                    VerticalAlignment="Center"
                                    IsEnabled="False"/>
                        </StackPanel>

                        <!-- Second Row: Document controls and conversation mode -->
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <!-- Conversation mode -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="Mode" FontSize="14" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbConversationModeQuickQA"
                                          SelectedIndex="0"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="Single-turn" Tag="Single"/>
                                    <ComboBoxItem Content="Multi-turn" Tag="Multi"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Document upload controls -->
                            <Button x:Name="BtnQuickQALoad" Content="📁 Load document"
                                    Click="BtnQuickQALoad_Click" IsEnabled="False"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblQuickQADoc" Text="No document loaded"
                                       VerticalAlignment="Center" Foreground="Gray" FontSize="14"
                                       MaxWidth="400" TextTrimming="CharacterEllipsis"/>
                            <Button x:Name="BtnQuickQAClear" Content="❌ Clear"
                                    Click="BtnQuickQAClear_Click" IsEnabled="False"
                                    VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Chat History -->
                    <ListView x:Name="ChatHistoryListQuickQA" Grid.Row="2"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="None"
                              Margin="0,0,0,12">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="ContextFlyout">
                                    <Setter.Value>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Copy" Icon="Copy" Click="CopyMessage_Click"/>
                                        </MenuFlyout>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <!-- User message (right-aligned, Teams purple-blue) -->
                                    <Border Visibility="{Binding IsUserVisible}"
                                            Background="{ThemeResource UserBubbleBackground}"
                                            CornerRadius="12"
                                            Padding="12,8"
                                            HorizontalAlignment="Right"
                                            MaxWidth="600">
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource UserBubbleText}"
                                                   IsTextSelectionEnabled="True"/>
                                    </Border>

                                    <!-- AI message (left-aligned, dark/light gray) -->
                                    <Border Visibility="{Binding IsAssistantVisible}"
                                            Background="{ThemeResource AIBubbleBackground}"
                                            CornerRadius="12"
                                            Padding="12,8"
                                            HorizontalAlignment="Left"
                                            MaxWidth="600">
                                        <TextBlock Text="{Binding Content}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{ThemeResource AIBubbleText}"
                                                   IsTextSelectionEnabled="True"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Input Box -->
                    <TextBox x:Name="TxtQuickQAInput" Grid.Row="3"
                             PlaceholderText="Type your question about the document (Ctrl+Enter to send)..."
                             TextWrapping="Wrap" AcceptsReturn="True"
                             PreviewKeyDown="TxtQuickQAInput_PreviewKeyDown"/>

                    <!-- Send Button -->
                    <Button x:Name="BtnQuickQASend" Grid.Row="4"
                            Content="Send (Ctrl+Enter)"
                            Click="BtnQuickQASend_Click"
                            HorizontalAlignment="Stretch"
                            Margin="0,24,0,0"
                            IsEnabled="False"/>
                </Grid>

                <!-- 🔍 智能解析页面 -->
                <Grid x:Name="IEPage" Padding="16" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Top" Spacing="12">
                        <TextBlock Text="🔍 智能解析" FontSize="20" FontWeight="Bold"/>

                        <!-- IE 控制按钮 -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnIELoad" Content="📎 加载文件"
                                    Click="BtnIELoad_Click" IsEnabled="False"/>
                            <ComboBox x:Name="CmbIETemplate"
                                      SelectionChanged="CmbIETemplate_SelectionChanged"
                                      IsEnabled="False"
                                      MinWidth="150">
                                <!-- 模板选项会在代码中动态填充 -->
                            </ComboBox>
                            <TextBlock x:Name="LblIEDoc" Text="未加载文档"
                                       VerticalAlignment="Center" Foreground="Gray"/>
                            <Button x:Name="BtnIEExtract" Content="▶️ 开始提取"
                                    Click="BtnIEExtract_Click" IsEnabled="False"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="LblIEStatus" Text=""
                                       VerticalAlignment="Center" Foreground="Gray"/>
                            <Button x:Name="BtnIECopyJSON" Content="📋 复制JSON"
                                    Click="BtnIECopyJSON_Click" IsEnabled="False"/>
                            <Button x:Name="BtnIEExport" Content="💾 导出"
                                    Click="BtnIEExport_Click" IsEnabled="False"/>
                            <Button x:Name="BtnIEReExtract" Content="🔄 重新提取"
                                    Click="BtnIEReExtract_Click" IsEnabled="False"/>
                            <Button x:Name="BtnIEContinueDialog" Content="💬 继续提问"
                                    Click="BtnIEContinueDialog_Click" IsEnabled="False"/>
                        </StackPanel>

                        <TextBlock Text="从文档中提取结构化信息..." Foreground="Gray"/>
                    </StackPanel>
                </Grid>

                <!-- 📚 知识库页面 -->
                <Grid x:Name="RAGPage" Padding="16" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Top" Spacing="12">
                        <TextBlock Text="📚 知识库" FontSize="20" FontWeight="Bold"/>

                        <!-- RAG 控制按钮 -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="BtnRAGTest" Content="🧪 添加测试文档"
                                    Click="BtnRAGTest_Click" IsEnabled="False"/>
                            <Button x:Name="BtnDocumentManage" Content="📚 文档管理"
                                    Click="BtnDocumentManage_Click" IsEnabled="False"/>
                        </StackPanel>

                        <TextBlock Text="基于向量检索的知识库问答..." Foreground="Gray"/>
                    </StackPanel>
                </Grid>

                <!-- 🖼️ 视觉理解页面（待迁移） -->
                <!-- Visual Understanding Page -->
                <Grid x:Name="LLaVAPage" Padding="16" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header with Controls -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Visual Understanding" FontSize="24" FontWeight="Bold" Margin="0,0,0,12"/>

                        <!-- Parameter Controls -->
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <!-- Answer Style -->
                            <ComboBox x:Name="CmbAnswerStyleVisual" MinWidth="150" SelectedIndex="2">
                                <ComboBoxItem Content="🎯 Concise" Tag="Concise"/>
                                <ComboBoxItem Content="💬 Conversational" Tag="Conversational"/>
                                <ComboBoxItem Content="📝 Detailed" Tag="Detailed"/>
                                <ComboBoxItem Content="🎓 Educational" Tag="Educational"/>
                                <ComboBoxItem Content="🔬 Technical" Tag="Technical"/>
                            </ComboBox>

                            <!-- Creativity -->
                            <ComboBox x:Name="CmbCreativityVisual" MinWidth="150" SelectedIndex="3">
                                <ComboBoxItem Content="🎯 Focused (0.3)" Tag="0.3"/>
                                <ComboBoxItem Content="🔒 Precise (0.5)" Tag="0.5"/>
                                <ComboBoxItem Content="⚖️ Balanced (0.7)" Tag="0.7"/>
                                <ComboBoxItem Content="🎨 Creative (0.9)" Tag="0.9"/>
                                <ComboBoxItem Content="🌟 Imaginative (1.0)" Tag="1.0"/>
                            </ComboBox>

                            <!-- Max Length -->
                            <ComboBox x:Name="CmbMaxLengthVisual" MinWidth="150" SelectedIndex="2">
                                <ComboBoxItem Content="📄 Short (512)" Tag="512"/>
                                <ComboBoxItem Content="📑 Medium (1024)" Tag="1024"/>
                                <ComboBoxItem Content="📚 Long (2048)" Tag="2048"/>
                                <ComboBoxItem Content="📖 Extended (4096)" Tag="4096"/>
                            </ComboBox>

                            <!-- Clear Chat Button -->
                            <Button x:Name="BtnClearVisualChat" Click="BtnClearVisualChat_Click" Margin="24,0,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    <TextBlock Text="Clear Chat"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- Chat History -->
                    <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <ScrollViewer x:Name="ScrollViewerVisual" Padding="16" VerticalScrollBarVisibility="Auto">
                            <ListView x:Name="ChatHistoryVisual" ItemsSource="{x:Bind VisualChatHistory}"
                                      SelectionMode="None" ScrollViewer.VerticalScrollMode="Disabled">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0,4"/>
                                    </Style>
                                </ListView.ItemContainerStyle>
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <!-- User Message -->
                                            <Border Visibility="{Binding IsUserVisible}"
                                                    HorizontalAlignment="Right" MaxWidth="600"
                                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                                    CornerRadius="12" Padding="12,8" Margin="48,0,0,0">
                                                <StackPanel>
                                                    <!-- Image if present -->
                                                    <Border Visibility="{Binding ImageVisible}"
                                                            Margin="0,0,0,8" CornerRadius="8">
                                                        <Image Source="{Binding Image.Preview}"
                                                               MaxHeight="200" MaxWidth="400"
                                                               Stretch="Uniform"
                                                               Tapped="OnImageTapped_Visual"
                                                               Tag="{Binding Image}"/>
                                                    </Border>
                                                    <!-- Text Content -->
                                                    <TextBlock Text="{Binding Content}"
                                                               TextWrapping="Wrap"
                                                               Foreground="White"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Assistant Message -->
                                            <Border Visibility="{Binding IsAssistantVisible}"
                                                    HorizontalAlignment="Left" MaxWidth="600"
                                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12" Padding="12,8" Margin="0,0,48,0">
                                                <TextBlock Text="{Binding Content}"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>
                    </Border>

                    <!-- Input Area -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Input Box with Drag-Drop -->
                        <Border Grid.Column="0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8"
                                AllowDrop="True"
                                DragEnter="OnDragEnter_Visual"
                                DragLeave="OnDragLeave_Visual"
                                DragOver="OnDragOver_Visual"
                                Drop="OnDrop_Visual">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Current Image Preview Bar -->
                                <Border x:Name="CurrentImageBarVisual" Grid.Row="0"
                                        Visibility="Collapsed"
                                        Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                        Padding="8,4">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Thumbnail -->
                                        <Image x:Name="CurrentImageThumbnailVisual" Grid.Column="0"
                                               Height="40" Width="40" Stretch="UniformToFill"
                                               Margin="0,0,8,0"/>

                                        <!-- File Name -->
                                        <TextBlock x:Name="CurrentImageNameVisual" Grid.Column="1"
                                                   VerticalAlignment="Center"/>

                                        <!-- Remove Button -->
                                        <Button Grid.Column="2" Click="RemoveImage_Visual"
                                                Background="Transparent" BorderThickness="0">
                                            <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- Text Input -->
                                <TextBox x:Name="InputBoxVisual" Grid.Row="1"
                                         PlaceholderText="Describe your image or drag &amp; drop an image file here..."
                                         TextWrapping="Wrap" MinHeight="60" MaxHeight="120"
                                         AcceptsReturn="True" BorderThickness="0"
                                         KeyDown="InputBoxVisual_KeyDown"
                                         Padding="12,8"/>
                            </Grid>
                        </Border>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                            <!-- Upload Image Button -->
                            <Button x:Name="BtnUploadImageVisual" Click="BtnUploadImageVisual_Click"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xEB9F;" FontSize="16"/>
                                    <TextBlock Text="Image"/>
                                </StackPanel>
                            </Button>

                            <!-- Send Button -->
                            <Button x:Name="BtnSendVisual" Click="BtnSendVisual_Click"
                                    Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE724;" FontSize="16"/>
                                    <TextBlock Text="Send"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Image Preview Overlay -->
                    <Grid x:Name="ImagePreviewOverlayVisual"
                          Grid.RowSpan="3"
                          Background="#CC000000"
                          Visibility="Collapsed"
                          Tapped="CloseImagePreview_Visual">
                        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Image x:Name="PreviewImageVisual"
                                   MaxWidth="900" MaxHeight="700"
                                   Stretch="Uniform"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 🎨 图像生成页面 (Stable Diffusion) -->
                <Grid x:Name="SDPage" Padding="32" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="120"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Text="图像生成" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>

                    <!-- Configuration Panel -->
                    <StackPanel Grid.Row="1" Spacing="16" Margin="0,0,0,24">
                        <!-- First Row: Style, Size, Quality, Clear -->
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="风格" FontSize="14" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbSDStyle" SelectedIndex="0" VerticalAlignment="Center" MinWidth="100">
                                    <ComboBoxItem Content="默认"/>
                                    <ComboBoxItem Content="写实"/>
                                    <ComboBoxItem Content="卡通"/>
                                    <ComboBoxItem Content="油画"/>
                                    <ComboBoxItem Content="水彩"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="尺寸" FontSize="14" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbSDSize" SelectedIndex="0" VerticalAlignment="Center" MinWidth="120">
                                    <ComboBoxItem Content="512 x 512"/>
                                    <ComboBoxItem Content="768 x 768"/>
                                    <ComboBoxItem Content="1024 x 1024"/>
                                    <ComboBoxItem Content="512 x 768"/>
                                    <ComboBoxItem Content="768 x 512"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="质量" FontSize="14" VerticalAlignment="Center"/>
                                <ComboBox x:Name="CmbSDQuality" SelectedIndex="1" VerticalAlignment="Center" MinWidth="100">
                                    <ComboBoxItem Content="快速 (15步)"/>
                                    <ComboBoxItem Content="标准 (20步)"/>
                                    <ComboBoxItem Content="高质量 (30步)"/>
                                </ComboBox>
                            </StackPanel>

                            <Button x:Name="BtnSDClear" Content="清空历史"
                                    Click="BtnSDClear_Click" VerticalAlignment="Center" IsEnabled="False"/>
                        </StackPanel>

                        <!-- Second Row: Mode selection and negative prompt (collapsed) -->
                        <StackPanel Orientation="Horizontal" Spacing="20">
                            <Button x:Name="BtnSDSingle" Content="单轮模式"
                                    Click="BtnSDSingle_Click" IsEnabled="False"/>
                            <Button x:Name="BtnSDMulti" Content="多轮模式 (迭代修改)"
                                    Click="BtnSDMulti_Click" IsEnabled="False"/>
                            <TextBlock x:Name="LblSDMode" Text="[单轮模式]"
                                       VerticalAlignment="Center" Foreground="Gray"/>
                        </StackPanel>

                        <!-- Negative Prompt (Expander) -->
                        <Expander Header="反向提示词 (可选)" IsExpanded="False">
                            <TextBox x:Name="TxtNegativePrompt"
                                     PlaceholderText="lowres, bad anatomy, bad hands..."
                                     Height="60" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </Expander>
                    </StackPanel>

                    <!-- Chat History with Images -->
                    <ListView x:Name="SDChatList" Grid.Row="2"
                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                              SelectionMode="None"
                              Margin="0,0,0,12">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="4"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,2">
                                    <!-- User message (right) -->
                                    <Border Visibility="{Binding IsUserVisible}"
                                            Background="{ThemeResource UserBubbleBackground}"
                                            CornerRadius="12" Padding="12,8"
                                            HorizontalAlignment="Right" MaxWidth="600">
                                        <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                   Foreground="{ThemeResource UserBubbleText}"
                                                   IsTextSelectionEnabled="True"/>
                                    </Border>

                                    <!-- AI message with image (left) -->
                                    <Border Visibility="{Binding IsAssistantVisible}"
                                            Background="{ThemeResource AIBubbleBackground}"
                                            CornerRadius="12" Padding="12,8"
                                            HorizontalAlignment="Left" MaxWidth="600">
                                        <StackPanel Spacing="8">
                                            <!-- Progress indicator -->
                                            <StackPanel Visibility="{Binding ProgressVisible}" Spacing="4">
                                                <TextBlock Text="{Binding ProgressText}" FontSize="12"
                                                           Foreground="{ThemeResource AIBubbleText}"/>
                                                <ProgressBar Value="{Binding GenerationProgress}"
                                                             Maximum="100" Height="4"/>
                                            </StackPanel>

                                            <!-- Generated image -->
                                            <Image Source="{Binding Image.Preview}" 
                                                   Visibility="{Binding ImageVisible}"
                                                   MaxWidth="512" MaxHeight="512"
                                                   Stretch="Uniform"/>

                                            <!-- Generation info -->
                                            <TextBlock Text="{Binding GenerationInfo}"
                                                       FontSize="11" Foreground="{ThemeResource AIBubbleText}"
                                                       Opacity="0.8"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Input Box -->
                    <TextBox x:Name="TxtSDInput" Grid.Row="3"
                             PlaceholderText="描述你想要生成的图片... (Ctrl+Enter 生成)"
                             TextWrapping="Wrap" AcceptsReturn="True"
                             PreviewKeyDown="TxtSDInput_PreviewKeyDown"/>

                    <!-- Action buttons row -->
                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Image operation buttons (only visible when image selected) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <AppBarButton Label="保存" Click="BtnSaveImage_Click" IsEnabled="False">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE74E;"/>
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="复制" Click="BtnCopyImage_Click" IsEnabled="False">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE8C8;"/>
                                </AppBarButton.Icon>
                            </AppBarButton>
                            <AppBarButton Label="重新生成" Click="BtnRegenerate_Click" IsEnabled="False">
                                <AppBarButton.Icon>
                                    <FontIcon Glyph="&#xE72C;"/>
                                </AppBarButton.Icon>
                            </AppBarButton>
                        </StackPanel>

                        <!-- Right: Generate button -->
                        <Button x:Name="BtnSDGenerate" Grid.Column="1"
                                Content="生成 (Ctrl+Enter)"
                                Click="BtnSDGenerate_Click"
                                IsEnabled="False"
                                Style="{ThemeResource AccentButtonStyle}"
                                MinWidth="160"/>
                    </Grid>
                </Grid>

                <!-- 帮助页面 -->
                <Grid x:Name="HelpPage" Padding="16" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                        <TextBlock Text="📚 帮助中心" FontSize="32" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="帮助内容待添加..." FontSize="16" Foreground="Gray" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Settings Page (Windows 11 Settings Style) -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!-- Main content container -->
                        <Grid Padding="32">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Page Title -->
                            <TextBlock Text="Settings"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       Margin="0,0,0,24"/>

                            <!-- Settings Content -->
                            <StackPanel Grid.Row="1" Spacing="4">

                                <!-- Appearance Section -->
                                <StackPanel Spacing="4">
                                    <TextBlock Text="Appearance"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>

                                    <!-- Theme Setting Card -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon -->
                                            <FontIcon Grid.Column="0"
                                                      Glyph="&#xE771;"
                                                      FontSize="20"
                                                      Margin="0,0,24,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>

                                            <!-- Title and Description -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"
                                                        MaxWidth="480">
                                                <TextBlock Text="App theme"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="Choose between light, dark, or system theme"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- Spacer Column -->

                                            <!-- ComboBox (Auto Width) -->
                                            <ComboBox x:Name="ThemeComboBox"
                                                      Grid.Column="3"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Margin="32,0,0,0"
                                                      SelectionChanged="ThemeComboBox_SelectionChanged"
                                                      SelectedIndex="0">
                                                <ComboBoxItem Content="Use system setting" Tag="Default"/>
                                                <ComboBoxItem Content="Light" Tag="Light"/>
                                                <ComboBoxItem Content="Dark" Tag="Dark"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <!-- Language Setting Card -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon -->
                                            <FontIcon Grid.Column="0"
                                                      Glyph="&#xF2B7;"
                                                      FontSize="20"
                                                      Margin="0,0,24,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>

                                            <!-- Title and Description -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"
                                                        MaxWidth="480">
                                                <TextBlock Text="Display language"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="Choose the language for the application interface"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- Spacer Column -->

                                            <!-- ComboBox (Auto Width) -->
                                            <ComboBox x:Name="LanguageComboBox"
                                                      Grid.Column="3"
                                                      HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Margin="32,0,0,0"
                                                      SelectedIndex="0">
                                                <ComboBoxItem Content="English (United Kingdom)" Tag="en-GB"/>
                                                <ComboBoxItem Content="简体中文（中国）" Tag="zh-CN"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Audio Testing Section -->
                                <StackPanel Spacing="4" Margin="0,20,0,0">
                                    <TextBlock Text="Audio testing"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>

                                    <!-- Microphone Test Card -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon -->
                                                <FontIcon Grid.Column="0"
                                                          Glyph="&#xE720;"
                                                          FontSize="20"
                                                          Margin="0,0,24,0"
                                                          VerticalAlignment="Center"
                                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>

                                                <!-- Title and Description -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"
                                                            MaxWidth="480">
                                                    <TextBlock Text="Microphone test"
                                                               FontSize="16"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="Test your microphone and view audio levels"
                                                               FontSize="12"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>

                                                <!-- Spacer Column (Grid.Column="2") with Width="*" pushes button to the right -->

                                                <!-- Test Button -->
                                                <Button x:Name="BtnMicrophoneTest"
                                                        Grid.Column="3"
                                                        Content="Start test"
                                                        Click="BtnMicrophoneTest_Click"
                                                        MinWidth="120"
                                                        VerticalAlignment="Center"
                                                        Margin="32,0,0,0"/>
                                            </Grid>

                                            <!-- Volume Indicator (Collapsed by default) -->
                                            <StackPanel x:Name="MicrophoneVolumePanel"
                                                        Grid.Row="1"
                                                        Visibility="Collapsed"
                                                        Margin="44,12,0,0"
                                                        Spacing="8">
                                                <TextBlock Text="Volume level:"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <ProgressBar x:Name="MicrophoneVolumeBar"
                                                             Height="8"
                                                             Maximum="100"
                                                             Value="0"
                                                             CornerRadius="4"/>
                                                <TextBlock x:Name="MicrophoneVolumeText"
                                                           Text="0%"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Speaker Test Card -->
                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="16"
                                            Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Icon -->
                                            <FontIcon Grid.Column="0"
                                                      Glyph="&#xE767;"
                                                      FontSize="20"
                                                      Margin="0,0,24,0"
                                                      VerticalAlignment="Center"
                                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>

                                            <!-- Title and Description -->
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"
                                                        MaxWidth="480">
                                                <TextBlock Text="Speaker test"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="Test your speakers with a sample sound"
                                                           FontSize="12"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>

                                            <!-- Spacer Column -->

                                            <!-- Test Button -->
                                            <Button x:Name="BtnSpeakerTest"
                                                    Grid.Column="3"
                                                    Content="Play test sound"
                                                    Click="BtnSpeakerTest_Click"
                                                    MinWidth="120"
                                                    VerticalAlignment="Center"
                                                    Margin="32,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- About Section -->
                                <StackPanel Spacing="4" Margin="0,20,0,0">
                                    <TextBlock Text="About"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,8"/>

                                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="24">
                                        <StackPanel Spacing="4">
                                            <TextBlock Text="MeetingAI"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="Version 1.0.0"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            <TextBlock Text="Local AI assistant powered by OpenVINO"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </NavigationView.Content>
    </NavigationView>
    </Grid>
</Window>
