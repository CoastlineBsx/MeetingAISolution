<Page
    x:Class="MeetingAI.Host.Pages.OpenVINOWhisperPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="24" Spacing="16" MaxWidth="1200">

            <!-- 页面标题 -->
            <StackPanel Spacing="8">
                <TextBlock
                    Text="OpenVINO Whisper 转录"
                    Style="{StaticResource TitleTextBlockStyle}"/>
                <TextBlock
                    Text="使用 Intel OpenVINO GenAI 引擎进行高性能语音识别，支持 DTW 时间戳对齐"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- 文件选择区域 -->
            <InfoBar
                x:Name="FileInfoBar"
                Title="📁 音频文件"
                IsOpen="True"
                IsClosable="False"
                Severity="Informational">
                <InfoBar.Content>
                    <StackPanel Spacing="12">
                        <TextBlock
                            x:Name="TxtSelectedFile"
                            Text="未选择文件"
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <Button
                            x:Name="BtnSelectFile"
                            Content="选择音频文件"
                            Click="BtnSelectFile_Click"
                            Style="{StaticResource AccentButtonStyle}"/>
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <!-- 配置区域 -->
            <Expander Header="🎛️ 转录配置" IsExpanded="True">
                <StackPanel Spacing="16" Padding="16">

                    <!-- 转录模式选择 -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="转录模式" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <RadioButtons x:Name="RadioTranscriptionMode" SelectionChanged="RadioTranscriptionMode_SelectionChanged">
                            <RadioButton Content="📁 文件转录" IsChecked="True" Tag="file"/>
                            <RadioButton Content="🔊 扬声器录音转录" Tag="speaker"/>
                            <RadioButton Content="🎤 麦克风录音转录" Tag="microphone"/>
                        </RadioButtons>
                    </StackPanel>

                    <!-- 语言选择 -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="语言" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                        <ComboBox
                            x:Name="CmbLanguage"
                            SelectedIndex="0"
                            MinWidth="200"
                            HorizontalAlignment="Left">
                            <ComboBoxItem Content="🌐 自动检测"/>
                            <ComboBoxItem Content="🇨🇳 中文"/>
                            <ComboBoxItem Content="🇺🇸 English"/>
                            <ComboBoxItem Content="🇯🇵 日本語"/>
                            <ComboBoxItem Content="🇰🇷 한국어"/>
                            <ComboBoxItem Content="🇪🇸 Español"/>
                            <ComboBoxItem Content="🇫🇷 Français"/>
                            <ComboBoxItem Content="🇩🇪 Deutsch"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- 时间戳显示 -->
                    <ToggleSwitch
                        x:Name="ToggleShowTimestamps"
                        Header="显示时间戳"
                        IsOn="True"
                        OnContent="开启"
                        OffContent="关闭"/>

                </StackPanel>
            </Expander>

            <!-- 操作按钮区域 -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Button
                    x:Name="BtnStart"
                    Content="🚀 开始转录"
                    Click="BtnStart_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="140"/>
                <Button
                    x:Name="BtnStopRecording"
                    Content="⏹️ 停止录音"
                    Click="BtnStopRecording_Click"
                    Visibility="Collapsed"
                    MinWidth="140"/>
                <Button
                    x:Name="BtnExport"
                    Content="💾 导出 TXT"
                    Click="BtnExport_Click"
                    IsEnabled="False"
                    MinWidth="120"/>
                <Button
                    x:Name="BtnClear"
                    Content="🗑️ 清空结果"
                    Click="BtnClear_Click"
                    IsEnabled="False"/>
            </StackPanel>

            <!-- 进度显示 -->
            <StackPanel x:Name="ProgressPanel" Spacing="8" Visibility="Collapsed">
                <ProgressBar
                    x:Name="ProgressBar"
                    IsIndeterminate="False"
                    Value="0"
                    Maximum="100"/>
                <TextBlock
                    x:Name="TxtProgress"
                    Text="准备中..."
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- 转录结果 -->
            <StackPanel Spacing="8">
                <TextBlock
                    Text="📝 转录结果"
                    Style="{StaticResource SubtitleTextBlockStyle}"/>

                <Border
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    MinHeight="300"
                    MaxHeight="500">

                    <ListView
                        x:Name="ResultListView"
                        SelectionMode="None"
                        Padding="12">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="4" Padding="8">
                                    <!-- 时间戳 -->
                                    <TextBlock
                                        Text="{Binding Timestamp}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                        Visibility="{Binding ShowTimestamp}"/>
                                    <!-- 文本 -->
                                    <TextBlock
                                        Text="{Binding Text}"
                                        TextWrapping="Wrap"
                                        Style="{StaticResource BodyTextBlockStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Border>
            </StackPanel>

            <!-- 统计信息 -->
            <Border
                x:Name="StatsPanel"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16"
                Visibility="Collapsed">
                <StackPanel Spacing="8">
                    <TextBlock Text="📊 统计信息" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                    <TextBlock x:Name="TxtStats" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
