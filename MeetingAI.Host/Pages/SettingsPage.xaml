<Page
    x:Class="MeetingAI.Host.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Main content container -->
        <Grid Padding="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Page Title -->
            <TextBlock Text="Settings"
                       FontSize="32"
                       FontWeight="Bold"
                       Margin="0,0,0,24"/>

            <!-- Settings Content -->
            <StackPanel Grid.Row="1" Spacing="4">

                <!-- Appearance Section -->
                <StackPanel Spacing="4">
                    <TextBlock Text="Appearance"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <!-- Theme Setting Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE771;"
                                      FontSize="20"
                                      Margin="0,0,24,0"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>

                            <!-- Title and Description -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"
                                        MaxWidth="480">
                                <TextBlock Text="App theme"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Choose between light, dark, or system theme"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Spacer Column -->

                            <!-- ComboBox (Auto Width) -->
                            <ComboBox x:Name="ThemeComboBox"
                                      Grid.Column="3"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="32,0,0,0"
                                      SelectionChanged="ThemeComboBox_SelectionChanged"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Use system setting" Tag="Default"/>
                                <ComboBoxItem Content="Light" Tag="Light"/>
                                <ComboBoxItem Content="Dark" Tag="Dark"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Language Setting Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xF2B7;"
                                      FontSize="20"
                                      Margin="0,0,24,0"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>

                            <!-- Title and Description -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"
                                        MaxWidth="480">
                                <TextBlock Text="Display language"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Choose the language for the application interface"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Spacer Column -->

                            <!-- ComboBox (Auto Width) -->
                            <ComboBox x:Name="LanguageComboBox"
                                      Grid.Column="3"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Margin="32,0,0,0"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="English (United Kingdom)" Tag="en-GB"/>
                                <ComboBoxItem Content="简体中文（中国）" Tag="zh-CN"/>
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Audio Testing Section -->
                <StackPanel Spacing="4" Margin="0,20,0,0">
                    <TextBlock Text="Audio testing"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <!-- Microphone Test Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Icon -->
                                <FontIcon Grid.Column="0"
                                          Glyph="&#xE720;"
                                          FontSize="20"
                                          Margin="0,0,24,0"
                                          VerticalAlignment="Center"
                                          Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>

                                <!-- Title and Description -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"
                                            MaxWidth="480">
                                    <TextBlock Text="Microphone test"
                                               FontSize="16"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Test your microphone and view audio levels"
                                               FontSize="12"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Spacer Column (Grid.Column="2") with Width="*" pushes button to the right -->

                                <!-- Test Button -->
                                <Button x:Name="BtnMicrophoneTest"
                                        x:FieldModifier="public"
                                        Grid.Column="3"
                                        Content="Start test"
                                        Click="BtnMicrophoneTest_Click"
                                        MinWidth="120"
                                        VerticalAlignment="Center"
                                        Margin="32,0,0,0"/>
                            </Grid>

                            <!-- Volume Indicator (Collapsed by default) -->
                            <StackPanel x:Name="MicrophoneVolumePanel"
                                        x:FieldModifier="public"
                                        Grid.Row="1"
                                        Visibility="Collapsed"
                                        Margin="44,12,0,0"
                                        Spacing="8">
                                <TextBlock Text="Volume level:"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ProgressBar x:Name="MicrophoneVolumeBar"
                                             x:FieldModifier="public"
                                             Height="8"
                                             Maximum="100"
                                             Value="0"
                                             CornerRadius="4"/>
                                <TextBlock x:Name="MicrophoneVolumeText"
                                           x:FieldModifier="public"
                                           Text="0%"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Speaker Test Card -->
                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="16"
                            Margin="0,0,0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Icon -->
                            <FontIcon Grid.Column="0"
                                      Glyph="&#xE767;"
                                      FontSize="20"
                                      Margin="0,0,24,0"
                                      VerticalAlignment="Center"
                                      Foreground="{ThemeResource AccentFillColorDefaultBrush}"/>

                            <!-- Title and Description -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4"
                                        MaxWidth="480">
                                <TextBlock Text="Speaker test"
                                           FontSize="16"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Test your speakers with a sample sound"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <!-- Spacer Column -->

                            <!-- Test Button -->
                            <Button x:Name="BtnSpeakerTest"
                                    x:FieldModifier="public"
                                    Grid.Column="3"
                                    Content="Play test sound"
                                    Click="BtnSpeakerTest_Click"
                                    MinWidth="120"
                                    VerticalAlignment="Center"
                                    Margin="32,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- About Section -->
                <StackPanel Spacing="4" Margin="0,20,0,0">
                    <TextBlock Text="About"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8"/>

                    <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="24">
                        <StackPanel Spacing="4">
                            <TextBlock Text="MeetingAI"
                                       FontSize="16"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Version 1.0.0"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock Text="Local AI assistant powered by OpenVINO"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
