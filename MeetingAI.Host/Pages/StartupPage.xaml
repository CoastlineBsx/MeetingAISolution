<Page
    x:Class="MeetingAI.Host.Pages.StartupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Startup &amp; Model Initialization" FontSize="28" FontWeight="Bold" Margin="0,0,0,32"/>

        <!-- Model Configuration Panel -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="24" MaxWidth="900">

                <!-- Granite & Embedding are independent resident models. -->
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Language &amp; Retrieval Models"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="All models are loaded only from this page. Feature pages never load models automatically."
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Granite Device Selection -->
                            <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,12,0">
                                <TextBlock Text="Granite Model Device" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="CmbGraniteDevice"
                                          x:FieldModifier="public"
                                          SelectedIndex="1"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="CPU"/>
                                    <ComboBoxItem Content="GPU"/>
                                    <ComboBoxItem Content="NPU"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Embedding Device Selection -->
                            <StackPanel Grid.Column="1" Spacing="8" Margin="12,0,0,0">
                                <TextBlock Text="Embedding Model Device" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="CmbEmbeddingDevice"
                                          x:FieldModifier="public"
                                          SelectedIndex="1"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="CPU"/>
                                    <ComboBoxItem Content="GPU"/>
                                    <ComboBoxItem Content="NPU"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8" Margin="0,12,12,0">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="BtnLoadGranite"
                                        x:FieldModifier="public"
                                        Content="Load Granite"
                                        Click="BtnLoadGranite_Click"
                                        HorizontalAlignment="Stretch"
                                        MinWidth="200"
                                        IsEnabled="False"
                                        Style="{ThemeResource AccentButtonStyle}"/>
                                <ProgressRing x:Name="ProgressGranite"
                                              x:FieldModifier="public"
                                              Width="24"
                                              Height="24"
                                              IsActive="False"
                                              Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtGraniteState"
                                           x:FieldModifier="public"
                                           Text="Not loaded"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8" Margin="12,12,0,0">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                <Button x:Name="BtnLoadEmbedding"
                                        x:FieldModifier="public"
                                        Content="Load Embedding"
                                        Click="BtnLoadEmbedding_Click"
                                        HorizontalAlignment="Stretch"
                                        MinWidth="200"
                                        IsEnabled="False"
                                        Style="{ThemeResource AccentButtonStyle}"/>
                                <ProgressRing x:Name="ProgressEmbedding"
                                              x:FieldModifier="public"
                                              Width="24"
                                              Height="24"
                                              IsActive="False"
                                              Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtEmbeddingState"
                                           x:FieldModifier="public"
                                           Text="Not loaded · OpenVINO GenAI TextEmbeddingPipeline"
                                           FontSize="12"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- OpenVINO Whisper Model Group -->
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="OpenVINO Whisper (High Performance)"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Intel GenAI accelerated speech recognition with DTW timestamps"
                                       FontSize="12"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Device Selection -->
                            <StackPanel Grid.Column="0" Spacing="8" Margin="0,0,12,0">
                                <TextBlock Text="Device" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <ComboBox x:Name="CmbOpenVINOWhisperDevice"
                                          x:FieldModifier="public"
                                          SelectedIndex="1"
                                          HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="CPU"/>
                                    <ComboBoxItem Content="GPU"/>
                                    <ComboBoxItem Content="NPU"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Model Path -->
                            <StackPanel Grid.Column="1" Spacing="8" Margin="12,0,0,0">
                                <TextBlock Text="Model Path" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Text="models/whisper_large_v3"
                                           FontSize="12"
                                           FontFamily="Consolas"
                                           VerticalAlignment="Center"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="BtnLoadOpenVINOWhisper"
                                    x:FieldModifier="public"
                                    Content="Load OpenVINO Whisper"
                                    Click="BtnLoadOpenVINOWhisper_Click"
                                    MinWidth="200"
                                    IsEnabled="False"
                                    Style="{ThemeResource AccentButtonStyle}"/>
                            <ProgressRing x:Name="ProgressOpenVINOWhisper"
                                          x:FieldModifier="public"
                                          Width="24"
                                          Height="24"
                                          IsActive="False"
                                          Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Streaming speech models -->
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="16">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Streaming Meeting Models"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="Sherpa and punctuation run on CPU. Load both before starting a meeting for the full caption experience."
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>

                        <Grid ColumnSpacing="24" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="8">
                                <TextBlock Text="Sherpa-ONNX Streaming ASR" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="BtnLoadSherpa"
                                            x:FieldModifier="public"
                                            Content="Load Sherpa"
                                            Click="BtnLoadSherpa_Click"
                                            MinWidth="200"
                                            IsEnabled="False"
                                            Style="{ThemeResource AccentButtonStyle}"/>
                                    <ProgressRing x:Name="ProgressSherpa"
                                                  x:FieldModifier="public"
                                                  Width="24" Height="24"
                                                  IsActive="False"
                                                  Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtSherpaState"
                                           x:FieldModifier="public"
                                           Text="Not loaded · CPU"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="8">
                                <TextBlock Text="Sherpa Bilingual Punctuation" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="BtnLoadPunctuator"
                                            x:FieldModifier="public"
                                            Content="Load Punctuation"
                                            Click="BtnLoadPunctuator_Click"
                                            MinWidth="200"
                                            IsEnabled="False"
                                            Style="{ThemeResource AccentButtonStyle}"/>
                                    <ProgressRing x:Name="ProgressPunctuator"
                                                  x:FieldModifier="public"
                                                  Width="24" Height="24"
                                                  IsActive="False"
                                                  Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtPunctuatorState"
                                           x:FieldModifier="public"
                                           Text="Not loaded · CPU"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="8">
                                <TextBlock Text="OPUS-MT English → Chinese" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="BtnLoadTranslationEnZh"
                                            x:FieldModifier="public"
                                            Content="Load EN → ZH"
                                            Click="BtnLoadTranslationEnZh_Click"
                                            MinWidth="200"
                                            IsEnabled="False"
                                            Style="{ThemeResource AccentButtonStyle}"/>
                                    <ProgressRing x:Name="ProgressTranslationEnZh"
                                                  x:FieldModifier="public"
                                                  Width="24" Height="24"
                                                  IsActive="False"
                                                  Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtTranslationEnZhState"
                                           x:FieldModifier="public"
                                           Text="Not loaded · CTranslate2 CPU"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="8">
                                <TextBlock Text="OPUS-MT Chinese → English" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Button x:Name="BtnLoadTranslationZhEn"
                                            x:FieldModifier="public"
                                            Content="Load ZH → EN"
                                            Click="BtnLoadTranslationZhEn_Click"
                                            MinWidth="200"
                                            IsEnabled="False"
                                            Style="{ThemeResource AccentButtonStyle}"/>
                                    <ProgressRing x:Name="ProgressTranslationZhEn"
                                                  x:FieldModifier="public"
                                                  Width="24" Height="24"
                                                  IsActive="False"
                                                  Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtTranslationZhEnState"
                                           x:FieldModifier="public"
                                           Text="Not loaded · CTranslate2 CPU"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- LLaVA Model Group -->
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Vision Model (LLaVA)"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="LLaVA Model Device" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="CmbLLaVADevice"
                                      x:FieldModifier="public"
                                      SelectedIndex="1"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="CPU"/>
                                <ComboBoxItem Content="GPU"/>
                                <ComboBoxItem Content="NPU"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="BtnLoadLLaVA"
                                    x:FieldModifier="public"
                                    Content="Load Model"
                                    Click="BtnLoadLLaVA_Click"
                                    MinWidth="200"
                                    IsEnabled="False"
                                    Style="{ThemeResource AccentButtonStyle}"/>
                            <ProgressRing x:Name="ProgressLLaVA"
                                          x:FieldModifier="public"
                                          Width="24"
                                          Height="24"
                                          IsActive="False"
                                          Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Stable Diffusion Model Group -->
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Image Generation (Stable Diffusion)"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <StackPanel Spacing="8">
                            <TextBlock Text="SD Model Device" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="CmbSDDevice"
                                      x:FieldModifier="public"
                                      SelectedIndex="2"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="CPU"/>
                                <ComboBoxItem Content="GPU"/>
                                <ComboBoxItem Content="NPU"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="BtnLoadSD"
                                    x:FieldModifier="public"
                                    Content="Load Model"
                                    Click="BtnLoadSD_Click"
                                    MinWidth="200"
                                    IsEnabled="False"
                                    Style="{ThemeResource AccentButtonStyle}"/>
                            <ProgressRing x:Name="ProgressSD"
                                          x:FieldModifier="public"
                                          Width="24"
                                          Height="24"
                                          IsActive="False"
                                          Visibility="Collapsed"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
