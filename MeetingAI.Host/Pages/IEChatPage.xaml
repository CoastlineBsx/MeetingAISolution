<Page x:Class="MeetingAI.Host.Pages.IEChatPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Grid Padding="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="120"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Text="Information Extraction" FontSize="28" FontWeight="Bold" Margin="0,0,0,24"/>

        <!-- Configuration Panel -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="24" Margin="0,0,0,24">
            <!-- Document Type Selection -->
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Document type" FontSize="14" VerticalAlignment="Center"/>
                <ComboBox x:Name="CmbIEChatTemplate"
                          x:FieldModifier="public"
                          SelectionChanged="CmbIEChatTemplate_SelectionChanged"
                          MinWidth="150"
                          IsEnabled="False"
                          VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Document Status -->
            <TextBlock x:Name="LblIEChatDocStatus"
                       x:FieldModifier="public"
                       Text="No document loaded"
                       FontSize="14"
                       VerticalAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

            <!-- Upload Document Button -->
            <Button x:Name="BtnIEChatUpload"
                    x:FieldModifier="public"
                    Click="BtnIEChatUpload_Click"
                    VerticalAlignment="Center"
                    IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8E5;" FontSize="16"/>
                    <TextBlock Text="Upload Document"/>
                </StackPanel>
            </Button>

            <!-- Extract Button -->
            <Button x:Name="BtnIEChatExtract"
                    x:FieldModifier="public"
                    Click="BtnIEChatExtract_Click"
                    IsEnabled="False"
                    VerticalAlignment="Center"
                    Style="{ThemeResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE8B5;" FontSize="16"/>
                    <TextBlock Text="Extract"/>
                </StackPanel>
            </Button>

            <!-- Clear history button -->
            <Button x:Name="BtnIEChatClear"
                    x:FieldModifier="public"
                    Content="Clear history"
                    Click="BtnIEChatClear_Click"
                    VerticalAlignment="Center"
                    IsEnabled="False"/>
        </StackPanel>

        <!-- Chat History -->
        <ListView x:Name="ChatHistoryListIE" Grid.Row="2"
                  x:FieldModifier="public"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  SelectionMode="None"
                  Margin="0,0,0,12">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="4"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="ContextFlyout">
                        <Setter.Value>
                            <MenuFlyout>
                                <MenuFlyoutItem Text="Copy" Icon="Copy" Click="CopyIEChatMessage_Click"/>
                            </MenuFlyout>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>

            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,2">
                        <!-- User message (right-aligned) -->
                        <Border Visibility="{Binding IsUserVisible}"
                                Background="{ThemeResource UserBubbleBackground}"
                                CornerRadius="12"
                                Padding="12,8"
                                HorizontalAlignment="Right"
                                MaxWidth="600">
                            <TextBlock Text="{Binding Content}"
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource UserBubbleText}"
                                       IsTextSelectionEnabled="True"/>
                        </Border>

                        <!-- Assistant message (left-aligned) -->
                        <Border Visibility="{Binding IsAssistantVisible}"
                                Background="{ThemeResource AIBubbleBackground}"
                                CornerRadius="12"
                                Padding="12,8"
                                HorizontalAlignment="Left"
                                MaxWidth="600">
                            <StackPanel Spacing="8">
                                <!-- Text content -->
                                <TextBlock Text="{Binding Content}"
                                           TextWrapping="Wrap"
                                           Foreground="{ThemeResource AIBubbleText}"
                                           IsTextSelectionEnabled="True"
                                           Visibility="{Binding ContentVisible}"/>

                                <!-- Generating indicator -->
                                <StackPanel Visibility="{Binding ProgressVisible}" Spacing="4">
                                    <ProgressRing IsActive="True" Width="20" Height="20"/>
                                    <TextBlock Text="Processing..." FontSize="12"
                                               Foreground="{ThemeResource AIBubbleText}"/>
                                </StackPanel>

                                <!-- JSON data display -->
                                <Border Visibility="{Binding JsonVisible}"
                                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="12"
                                        Margin="0,8,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Extracted Data" FontWeight="SemiBold" FontSize="12"/>
                                        <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto">
                                            <TextBlock Text="{Binding JsonContent}"
                                                       TextWrapping="Wrap"
                                                       FontFamily="Consolas"
                                                       FontSize="11"
                                                       IsTextSelectionEnabled="True"/>
                                        </ScrollViewer>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Copy JSON"
                                                    Click="BtnCopyIEJson_Click"
                                                    Tag="{Binding}"
                                                    FontSize="12"
                                                    Padding="8,4">
                                                <Button.Resources>
                                                    <x:String x:Key="action">copy</x:String>
                                                </Button.Resources>
                                            </Button>
                                            <Button Content="Export JSON"
                                                    Click="BtnExportIEJson_Click"
                                                    Tag="{Binding}"
                                                    FontSize="12"
                                                    Padding="8,4">
                                                <Button.Resources>
                                                    <x:String x:Key="action">export</x:String>
                                                </Button.Resources>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Input Box -->
        <TextBox x:Name="TxtIEChatInput" Grid.Row="3"
                 x:FieldModifier="public"
                 PlaceholderText="Ask questions about the extracted data or document (Ctrl+Enter to send)..."
                 TextWrapping="Wrap" AcceptsReturn="True"
                 PreviewKeyDown="TxtIEChatInput_PreviewKeyDown"/>

        <!-- Send Button -->
        <Button x:Name="BtnIEChatSend" Grid.Row="4"
                x:FieldModifier="public"
                Content="Send (Ctrl+Enter)"
                Click="BtnIEChatSend_Click"
                HorizontalAlignment="Right"
                Margin="0,12,0,0"
                IsEnabled="False"
                MinWidth="160"
                Style="{ThemeResource AccentButtonStyle}"/>
    </Grid>
</Page>
