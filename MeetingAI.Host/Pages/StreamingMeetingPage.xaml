<Page
    x:Class="MeetingAI.Host.Pages.StreamingMeetingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,24">
            <TextBlock Text="🎙️ Streaming Meeting (Real-time Transcription)"
                       FontSize="28"
                       FontWeight="Bold"/>
            <TextBlock Text="Sherpa-ONNX 流式转录 + CTranslate2 / OPUS-MT 实时翻译（全程离线）"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Border Padding="12" CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="会议上下文：" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox Grid.Column="1" x:Name="CmbMeetingContext"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="CmbMeetingContext_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" x:Name="BtnManageMeetingContext"
                            Content="管理会议资料" Click="BtnManageMeetingContext_Click"/>
                    <TextBlock Grid.Column="3" x:Name="TxtMeetingContextStatus"
                               Text="通用模式 · 不使用会前资料和热词"
                               VerticalAlignment="Center" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </Border>
        </StackPanel>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：实时字幕区 -->
            <Border Grid.Column="0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            Padding="16,12"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="📝 Real-time Captions"
                                       FontWeight="SemiBold"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    x:Name="BtnCopyCaptions"
                                    Click="BtnCopyCaptions_Click"
                                    Padding="10,4"
                                    ToolTipService.ToolTip="复制当前显示的全部原文和译文">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon Glyph="&#xE8C8;" FontSize="13"/>
                                    <TextBlock Text="复制全部"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 字幕列表。
                         不要再套 ScrollViewer：那样 ListView 会拿到无限高度，
                         UI 虚拟化失效，每插入一条就要重排整个列表（表现为页面闪一下）。 -->
                    <ListView x:Name="CaptionsList"
                                  x:FieldModifier="public"
                                  Grid.Row="1"
                                  Padding="16"
                                  SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0,8"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4">
                                        <!-- 说话人 + 时间戳 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding SpeakerName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding SpeakerColor}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Timestamp}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>

                                        <!-- 文本内容 -->
                                        <TextBlock Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True"
                                                   Opacity="{Binding TextOpacity}"/>
                                        <TextBlock Text="{Binding TranslatedDisplay}"
                                                   TextWrapping="Wrap"
                                                   IsTextSelectionEnabled="True"
                                                   FontStyle="Italic"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   Opacity="{Binding TranslationOpacity}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <!-- 右侧：说话人列表 + 控制区 -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- 说话人列表：暂不做分离，整块隐藏（绑定与逻辑保留） -->
                <Border Grid.Row="0"
                        Visibility="Collapsed"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                Padding="12,10"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="👥 Speakers"
                                       FontWeight="SemiBold"
                                       FontSize="14"/>
                        </Border>

                        <ListView x:Name="SpeakersList"
                                  x:FieldModifier="public"
                                  Grid.Row="1"
                                  Padding="12"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Rectangle Grid.Column="0"
                                                   Width="6"
                                                   Height="24"
                                                   RadiusX="3"
                                                   RadiusY="3"
                                                   Fill="{Binding ColorBrush}"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- 状态信息 -->
                <Border Grid.Row="0"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="📊 Status"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,4"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="音频来源:"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="CmbAudioSource"
                                      SelectedIndex="2"
                                      MinWidth="210">
                                <ComboBoxItem Content="我方（麦克风）"/>
                                <ComboBoxItem Content="对方（会议音频）"/>
                                <ComboBoxItem Content="我方 + 对方（同时）"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="同时监听建议佩戴耳机，避免对方声音被麦克风再次收录。"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="实时翻译:"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <ComboBox x:Name="CmbTranslationMode"
                                      SelectedIndex="1"
                                      MinWidth="210">
                                <ComboBoxItem Content="关闭"/>
                                <ComboBoxItem Content="自动互译（中 ↔ 英）"/>
                                <ComboBoxItem Content="译为中文（英文 → 中文）"/>
                                <ComboBoxItem Content="译为英文（中文 → 英文）"/>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Text="原文会立即显示，译文随后补到同一条字幕。"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="翻译状态:"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="TxtTranslationStatus"
                                       Text="未启动"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <CheckBox x:Name="ChkLiveSummary"
                                  IsChecked="True"
                                  Content="启用 Granite 本地实时速览与详细摘要"/>
                        <TextBlock Text="约一分钟自动更新实时速览；“生成详细摘要”会自适应会议内容，并包含当前尚未定稿的实时字幕。"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Duration:"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="TxtDuration"
                                       x:FieldModifier="public"
                                       Text="00:00:00"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <TextBlock Text="Speakers:"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="TxtSpeakerCount"
                                       x:FieldModifier="public"
                                       Text="0"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="State:"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="TxtStatus"
                                       x:FieldModifier="public"
                                       Text="Idle"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Segments:"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="TxtSegmentCount"
                                       x:FieldModifier="public"
                                       Text="0"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Granite 本地滚动会议摘要 -->
                <Border Grid.Row="2"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Padding="16"
                        MinHeight="260">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🧠 本地 AI 会议摘要"
                                       FontWeight="SemiBold"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    x:Name="BtnSummarizeNow"
                                    Click="BtnSummarizeNow_Click"
                                    IsEnabled="False"
                                    Padding="10,4">
                                <TextBlock Text="生成详细摘要"/>
                            </Button>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   x:Name="TxtSummaryStatus"
                                   Text="尚未启动"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Margin="0,0,0,8"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>

                        <ScrollViewer Grid.Row="2"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Spacing="8">
                                <TextBlock Text="实时速览"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="TxtMeetingSummary"
                                           Text="会议开始后，Granite 会在后台加载并持续更新实时速览。"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"/>
                                <Rectangle Height="1"
                                           Margin="0,6"
                                           Fill="{ThemeResource DividerStrokeColorDefaultBrush}"/>
                                <TextBlock Text="自适应详细摘要"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock x:Name="TxtDetailedMeetingSummary"
                                           Text="会议进行中可随时点击“生成详细摘要”。"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True"/>
                            </StackPanel>
                        </ScrollViewer>

                        <TextBlock Grid.Row="3"
                                   x:Name="TxtSummaryUpdated"
                                   Text=""
                                   Margin="0,8,0,0"
                                   FontSize="11"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Border>

            </Grid>
        </Grid>

        <!-- 底部：控制按钮 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center">

            <Button x:Name="BtnStartMeeting"
                    x:FieldModifier="public"
                    Click="BtnStartMeeting_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="140">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="16"/>
                    <TextBlock Text="Start Meeting"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnStopMeeting"
                    x:FieldModifier="public"
                    Click="BtnStopMeeting_Click"
                    IsEnabled="False"
                    MinWidth="140">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71A;" FontSize="16"/>
                    <TextBlock Text="Stop Meeting"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnExport"
                    x:FieldModifier="public"
                    Click="BtnExport_Click"
                    IsEnabled="False"
                    MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                    <TextBlock Text="Export"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnClear"
                    x:FieldModifier="public"
                    Click="BtnClear_Click"
                    IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                    <TextBlock Text="Clear"/>
                </StackPanel>
            </Button>
        </StackPanel>

    </Grid>
</Page>
