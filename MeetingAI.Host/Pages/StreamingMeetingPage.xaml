<Page
    x:Class="MeetingAI.Host.Pages.StreamingMeetingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <StackPanel Grid.Row="0" Spacing="12" Margin="0,0,0,24">
            <TextBlock Text="🎙️ Streaming Meeting (Real-time Transcription)"
                       FontSize="28"
                       FontWeight="Bold"/>
            <TextBlock Text="Powered by Sherpa-ONNX Zipformer · Real-time streaming transcription with speaker diarization"
                       FontSize="14"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- 主内容区 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧：实时字幕区 -->
            <Border Grid.Column="0"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 标题 -->
                    <Border Grid.Row="0"
                            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            Padding="16,12"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="📝 Real-time Captions"
                                   FontWeight="SemiBold"
                                   FontSize="16"/>
                    </Border>

                    <!-- 字幕列表 -->
                    <ScrollViewer Grid.Row="1" Padding="16">
                        <ListView x:Name="CaptionsList"
                                  x:FieldModifier="public"
                                  SelectionMode="None">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0,8"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="4">
                                        <!-- 说话人 + 时间戳 -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding SpeakerName}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{Binding SpeakerColor}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding Timestamp}"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </Grid>

                                        <!-- 文本内容 -->
                                        <TextBlock Text="{Binding Text}"
                                                   TextWrapping="Wrap"
                                                   Opacity="{Binding TextOpacity}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- 右侧：说话人列表 + 控制区 -->
            <StackPanel Grid.Column="2" Spacing="16">

                <!-- 说话人列表 -->
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                Padding="12,10"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="👥 Speakers"
                                       FontWeight="SemiBold"
                                       FontSize="14"/>
                        </Border>

                        <ListView x:Name="SpeakersList"
                                  x:FieldModifier="public"
                                  Grid.Row="1"
                                  Padding="12"
                                  SelectionMode="None">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="6"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Rectangle Grid.Column="0"
                                                   Width="6"
                                                   Height="24"
                                                   RadiusX="3"
                                                   RadiusY="3"
                                                   Fill="{Binding ColorBrush}"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding Name}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- 状态信息 -->
                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock Text="📊 Status"
                                   FontWeight="SemiBold"
                                   FontSize="14"
                                   Margin="0,0,0,4"/>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Duration:"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="TxtDuration"
                                       x:FieldModifier="public"
                                       Text="00:00:00"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Speakers:"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="TxtSpeakerCount"
                                       x:FieldModifier="public"
                                       Text="0"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="Segments:"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            <TextBlock x:Name="TxtSegmentCount"
                                       x:FieldModifier="public"
                                       Text="0"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid>

        <!-- 底部：控制按钮 -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="12"
                    Margin="0,24,0,0"
                    HorizontalAlignment="Center">

            <Button x:Name="BtnStartMeeting"
                    x:FieldModifier="public"
                    Click="BtnStartMeeting_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    MinWidth="140">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE768;" FontSize="16"/>
                    <TextBlock Text="Start Meeting"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnStopMeeting"
                    x:FieldModifier="public"
                    Click="BtnStopMeeting_Click"
                    IsEnabled="False"
                    MinWidth="140">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE71A;" FontSize="16"/>
                    <TextBlock Text="Stop Meeting"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnExport"
                    x:FieldModifier="public"
                    Click="BtnExport_Click"
                    IsEnabled="False"
                    MinWidth="120">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74E;" FontSize="16"/>
                    <TextBlock Text="Export"/>
                </StackPanel>
            </Button>

            <Button x:Name="BtnClear"
                    x:FieldModifier="public"
                    Click="BtnClear_Click"
                    IsEnabled="False">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                    <TextBlock Text="Clear"/>
                </StackPanel>
            </Button>
        </StackPanel>

    </Grid>
</Page>
